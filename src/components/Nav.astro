---
const isGuests = Astro.url.pathname === "/guests";
const isCalendar = Astro.url.pathname === "/calendar";
---

<nav aria-label="Main navigation" class="entrance flex items-center justify-between gap-3 py-5 border-b-[1.5px] border-line">
  <a
    href="/"
    class="group font-serif text-[21px] sm:text-[26px] leading-none flex items-baseline flex-wrap gap-x-1.5 gap-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-4 focus-visible:ring-offset-paper rounded-[5px]"
  >
    <span>The Towner</span>
    <span
      class="italic px-[7px] py-0.5 -rotate-2 bg-lime-soft rounded-[7px] inline-block transition-transform duration-200 group-hover:rotate-0"
      >Godpawrents</span
    >
  </a>
  <div class="flex gap-2">
    <a
      href="/calendar"
      aria-current={isCalendar ? "page" : undefined}
      class:list={[
        "relative font-sans font-semibold text-[13px] border-[1.5px] border-line px-[13px] py-1.5 rounded-full transition-all duration-200 hover:bg-lime hover:-translate-y-px active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-3 focus-visible:ring-offset-paper flex-none before:content-[''] before:absolute before:-top-[5px] before:-bottom-[5px] before:inset-x-0",
        { "bg-lime border-ink": isCalendar },
      ]}
    >
      Calendar
    </a>
    <a
      href="/guests"
      aria-current={isGuests ? "page" : undefined}
      class:list={[
        "relative font-sans font-semibold text-[13px] border-[1.5px] border-line px-[13px] py-1.5 rounded-full transition-all duration-200 hover:bg-lime hover:-translate-y-px active:translate-y-0 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink focus-visible:ring-offset-3 focus-visible:ring-offset-paper flex-none before:content-[''] before:absolute before:-top-[5px] before:-bottom-[5px] before:inset-x-0",
        { "bg-lime border-ink": isGuests },
      ]}
    >
      Past guests
    </a>
  </div>
</nav>
