---
interface Props {
  notes?: { left?: string; right?: string; leftUnderline?: string; rightUnderline?: string; inset?: { left?: number; right?: number } };
  aspectRatio?: number;
}

const { notes, aspectRatio = 640 / 853 } = Astro.props;
const hasNotes = Boolean(notes?.left || notes?.right);
const noteSides = (['right', 'left'] as const).map((side) => {
  const text = notes?.[side] ?? '';
  const underline = notes?.[`${side}Underline`] ?? '';
  const index = underline ? text.indexOf(underline) : -1;
  return { side, text, underline, index };
});
---

{hasNotes ? (
  <div class="portrait-notes" style={`--portrait-aspect:${aspectRatio};--note-inset-left:${notes?.inset?.left ?? 0};--note-inset-right:${notes?.inset?.right ?? 0}`}>
    <svg width="0" height="0" class="chalk-filter" aria-hidden="true" focusable="false">
      <filter id="diary-portrait-chalk" x="-5%" y="-10%" width="110%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="4" result="grain" />
        <feDisplacementMap in="SourceGraphic" in2="grain" scale="1.1" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <slot />
    {noteSides.map(({ side, text, underline, index }) => text && (
      <p class={`chalk-note chalk-note--${side}`}>
        {index >= 0 ? <>{text.slice(0, index)}<span class="chalk-underline">{underline}</span>{text.slice(index + underline.length)}</> : text}
        {index < 0 && <svg viewBox="0 0 40 26" aria-hidden="true" focusable="false">
          {side === 'right' ? <>
            <path d="M32 22 C25 17 14 14 3 16" />
            <path d="M10 11 3 16 11 21" />
          </> : <>
            <path d="M3 22 C10 17 21 14 37 16" />
            <path d="M30 11 37 16 29 21" />
          </>}
        </svg>}
      </p>
    ))}
  </div>
) : <slot />}

<style>
  .portrait-notes { position: relative; margin-top: 18px; container-type: inline-size; }
  .portrait-notes > *, .portrait-notes :global(.guest-cutout) {
    --portrait-width: min(270px, max(165px, 100cqi - 76px));
  }
  .portrait-notes :global(.guest-cutout) {
    width: var(--portrait-width);
    height: auto;
    aspect-ratio: var(--portrait-aspect);
    margin: 0 auto;
    padding: 0;
  }
  .chalk-filter { position: absolute; }
  .chalk-underline { position: relative; display: inline-block; }
  .chalk-underline::after {
    content: '';
    position: absolute;
    left: -2%;
    right: -3%;
    bottom: -0.13em;
    height: 0.16em;
    border-bottom: 1.7px solid currentColor;
    border-radius: 50%;
    transform: rotate(-3deg);
  }
  .chalk-note {
    position: absolute;
    margin: 0;
    font-family: var(--font-script);
    font-weight: 600;
    font-size: clamp(1.1875rem, 5.6cqi, 1.5rem);
    line-height: 0.98;
    color: var(--color-cream);
    opacity: 0.93;
    letter-spacing: 0.01em;
    text-wrap: balance;
    pointer-events: none;
    filter: url(#diary-portrait-chalk);
  }
  .chalk-note svg {
    position: absolute;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .chalk-note--right {
    left: calc(50% + (0.5 - var(--note-inset-right)) * var(--portrait-width) + 8px);
    top: calc(0.65 * var(--portrait-width));
    max-width: min(150px, calc(50% - (0.5 - var(--note-inset-right)) * var(--portrait-width) - 12px));
    transform: rotate(-4deg);
    transform-origin: left top;
  }
  .chalk-note--right svg { left: -22px; bottom: calc(100% + 2px); width: 40px; height: 26px; stroke-width: 1.7; }
  .chalk-note--left {
    right: calc(50% + (0.5 - var(--note-inset-left)) * var(--portrait-width) + 8px);
    top: calc(0.62 * var(--portrait-width));
    max-width: min(150px, calc(50% - (0.5 - var(--note-inset-left)) * var(--portrait-width) - 12px));
    text-align: right;
    transform: rotate(3deg);
    transform-origin: right top;
  }
  .chalk-note--left svg { right: -22px; top: calc(100% + 2px); width: 40px; height: 26px; stroke-width: 1.7; }

  @media (max-width: 639px) {
    .chalk-note { display: none; }

    .portrait-notes :global(.guest-cutout) {
      width: min(270px, 100%);
    }
  }
</style>
