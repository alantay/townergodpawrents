---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { dogNames } from "../lib/guests";

interface Props {
  photo?: ImageMetadata;
  name: string;
  class?: string;
  /** Already inside a print (the calendar polaroid, a bar dot): show only the empty slot. */
  bare?: boolean;
}

const { photo, name, class: className = "", bare = false } = Astro.props;

// No cut-out yet: an empty Polaroid per dog, name written underneath, waiting
// for a photo. Where a frame is already drawn around it, just the empty slot.
const dogs = dogNames(name);
---

{
  photo ? (
    <Image
      src={photo}
      alt={name}
      loading="eager"
      class={`h-full w-full object-contain ${className}`}
    />
  ) : bare ? (
    <span class={`slot slot--bare block h-full w-full ${className}`} role="img" aria-label={`${name}, no photo yet`} />
  ) : (
    <div class={`undeveloped h-full w-full ${className}`} role="img" aria-label={`${name}, no photo yet`} style={`--n:${dogs.length}`}>
      <div class="prints" aria-hidden="true">
        {dogs.map((dog) => (
          <div class="polaroid">
            <span class="slot"><span class="soon">photo soon</span></span>
            <span class="caption">{dog}</span>
          </div>
        ))}
      </div>
      <p class="waiting" aria-hidden="true">
        Still waiting for {dogs.length > 1 ? "them" : name} to sit still long enough.
      </p>
    </div>
  )
}

<style>
  .undeveloped {
    container: undeveloped / size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .prints {
    /* Polaroid height: as tall as the box allows, narrow enough for every dog to fit side by side. */
    --h: min(86cqh, calc(84cqw / var(--n) * 1.216));
    display: flex;
    align-items: flex-end;
    gap: calc(var(--h) * 0.07);
  }

  .polaroid {
    /* Real Polaroid proportions (88 × 107mm). */
    font-size: calc(var(--h) / 10);
    display: flex;
    flex-direction: column;
    width: 8.22em;
    height: 10em;
    padding: 0.45em 0.45em 1.5em;
    background: var(--color-cream);
    border-radius: 0.12em;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.44),
      0 0.25em 0.6em rgb(30 32 25 / 0.22);
    transform: rotate(-3deg);
    container-type: inline-size;
  }

  .polaroid:nth-child(even) { transform: rotate(2.5deg) translateY(-0.3em); }

  /* The empty photo area, ruled in pencil where the photo will go. */
  .slot {
    flex: 1;
    display: grid;
    place-items: center;
    border: 1px dashed var(--color-line);
    border-radius: 0.06em;
  }

  .slot--bare {
    background: var(--color-cream);
    background-clip: padding-box;
    border-color: var(--color-line);
    box-shadow: inset 0 0 0 3px var(--color-cream);
  }

  .soon,
  .caption,
  .waiting { display: none; }

  .soon {
    font-size: max(11px, 0.5em);
    letter-spacing: 0.08em;
    color: var(--color-label);
  }

  .caption {
    height: 1.9em;
    padding: 0 0.3em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: max(14px, 1.25em);
    line-height: 1.55;
    color: var(--color-ink);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .waiting {
    margin: 0;
    padding: 0 12px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.2;
    color: var(--color-lime-soft);
    text-align: center;
    text-wrap: balance;
  }

  /* Tall enough to write on the strip and add the joke (the hero, even when a
     pair shares it on a phone); below this the strip stays blank. */
  @container undeveloped (min-height: 200px) {
    .prints { --h: min(calc(100cqh - 64px), calc(84cqw / var(--n) * 1.216)); }
    .polaroid { padding-bottom: 0; }
    .soon, .caption, .waiting { display: block; }
  }

  /* A print too narrow for "photo soon" keeps just its dashed slot. */
  @container (max-width: 90px) {
    .soon { display: none; }
  }
</style>
