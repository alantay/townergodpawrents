---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { dogNames } from "../lib/guests";

interface Props {
  photo?: ImageMetadata;
  name: string;
  class?: string;
}

const { photo, name, class: className = "" } = Astro.props;

// No cut-out yet: a cream sticker with the dog's initials ("M", "H&L") stands
// in, so every size from the calendar dot to the hero reads as deliberate.
const initials = dogNames(name).map((n) => n[0]).join("&");
---

{
  photo ? (
    <Image
      src={photo}
      alt={`${name}, mid-stay`}
      loading="eager"
      class={`h-full w-full object-contain ${className}`}
    />
  ) : (
    <svg viewBox="0 0 100 100" role="img" aria-label={`${name}, no photo yet`} class={`h-full w-full ${className}`}>
      <g transform="rotate(-6 50 50)">
        <circle cx="50" cy="50" r="46" fill="#F7F2E7" />
        <text
          x="50"
          y="50"
          dy="0.35em"
          text-anchor="middle"
          font-size={initials.length > 1 ? 40 : 60}
          fill="#1E2019"
          class="font-serif"
        >
          {initials}
        </text>
      </g>
    </svg>
  )
}
