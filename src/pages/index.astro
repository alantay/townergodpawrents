---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Cutout from "../components/Cutout.astro";
import { Image } from "astro:assets";
import sofaCutout from "../assets/sofa-cutout-v2.png";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  parseDiary,
  pastGuests,
  staysNewestFirst,
  warnOnOverlaps,
  dateStr,
  todaySGT,
  pickToday,
} from "../lib/guests";

// Diary media is referenced from inside the markdown body, so it never
// passes through Astro's markdown image pipeline on its own — glob the
// folder to optimize photos anyway (videos aren't optimized by Astro, just
// resolved to a built URL). Mirrors the same helper in
// src/pages/guests/[id].astro; the homepage teaser needs the same media
// pre-resolved to plain URLs, since the card markup is built client-side.
const diaryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../content/guests/**/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);
const diaryVideos = import.meta.glob<string>("../content/guests/**/*.mp4", {
  eager: true,
  query: "?url",
  import: "default",
});
// ffprobe isn't available at Vercel build time, so prep-video.sh captures the
// encoded dimensions (portrait clips included) as a sidecar JSON file.
const diaryVideoDims = import.meta.glob<{ width: number; height: number }>(
  "../content/guests/**/*.mp4.json",
  { eager: true, import: "default" },
);

function resolveDiaryPhoto(src: string, guestId: string, when: string): ImageMetadata {
  const file = src.split("/").pop()!;
  const key = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[home] ${guestId}, ${when}: no image "${file}" in src/content/guests/ (written as "${src}")`,
    );
  }
  return diaryImages[key].default;
}

function resolveDiaryVideo(
  src: string,
  guestId: string,
  when: string,
): { src: string; poster: string; width: number; height: number } {
  const file = src.split("/").pop()!;
  const key = Object.keys(diaryVideos).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[home] ${guestId}, ${when}: no video "${file}" in src/content/guests/ (written as "${src}")`,
    );
  }
  const dimsKey = Object.keys(diaryVideoDims).find((k) => k.endsWith(`/${file}.json`));
  if (!dimsKey) {
    throw new Error(
      `[home] ${guestId}, ${when}: no "${file}.json" dimensions sidecar — re-run scripts/prep-video.sh`,
    );
  }
  const posterKey = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}.jpg`));
  if (!posterKey) {
    throw new Error(
      `[home] ${guestId}, ${when}: no "${file}.jpg" poster sidecar — re-run scripts/prep-video.sh`,
    );
  }
  const { width, height } = diaryVideoDims[dimsKey];
  return { src: diaryVideos[key], poster: diaryImages[posterKey].default.src, width, height };
}

const entries = await getCollection("guests");

const guests = entries.map((e) => {
  const stays = staysNewestFirst(
    e.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
  );
  warnOnOverlaps(e.id, stays);
  return {
    id: e.id,
    name: e.data.name,
    breed: e.data.breed,
    tagline: e.data.tagline ?? "",
    badge: e.data.badge ?? "",
    bgColor: e.data.bgColor,
    showLive: e.data.showLive,
    photo: e.data.photo,
    stays,
    days: parseDiary(e.body ?? "", stays, e.id),
  };
});

// Sent to the client so it can work out who's "here today" in the
// Asia/Singapore timezone at load time — see the inline script below.
// Cut-outs aren't included here; they're pre-optimized at build time into the
// hidden #photo-bank and the client just re-parents the <img> nodes it needs,
// so no image processing has to happen in the browser. Diary media IS
// included now (as plain resolved URLs, since the client builds the card
// markup itself) — the teaser shows today's whole day, media and all.
const guestsForClient = await Promise.all(
  guests.map(async ({ photo, days, ...rest }) => ({
    ...rest,
    days: await Promise.all(
      days.map(async (d) => ({
        iso: d.iso,
        entries: await Promise.all(
          d.entries.map(async (e) => {
            return {
              id: e.id,
              time: e.time,
              text: e.text,
              media: await Promise.all(e.media.map(async (m) => {
                if (m.kind === "video") {
                  const video = resolveDiaryVideo(m.src, rest.id, `${d.label} ${e.time}`);
                  return { kind: "video" as const, ...video, alt: m.alt };
                }
                const meta = resolveDiaryPhoto(m.src, rest.id, `${d.label} ${e.time}`);
                const img = await getImage({ src: meta, width: Math.min(meta.width, 1160) });
                return {
                  kind: "photo" as const,
                  src: img.src,
                  width: img.attributes.width,
                  height: img.attributes.height,
                  alt: m.alt,
                };
              })),
            };
          }),
        ),
      })),
    ),
  })),
);
const guestsJson = JSON.stringify(guestsForClient).replace(/</g, "\\u003c");

const hasPastGuests = pastGuests(guests, todaySGT()).length > 0;

// Footer sign-off, picked at random on each visit. Nobody finds this page
// except through a friend or neighbour, so none of these invite people in.
const footerLines = [
  "Know a dog who needs a sofa? You know where to find us.",
  "No bookings, no website form. Just neighbours and friends, one dog at a time.",
  "Word of mouth only. Mostly the dogs' mouths.",
  "Sofa's been furrier than usual lately.",
  "One sofa, many dogs, very little room for humans.",
  "Passed along by neighbours, one wagging tail at a time.",
  "Fur on the sofa, never the same colour twice.",
  "The vacuum is stuck with fur... again",
  "Our sofa has more regulars than most kopitiams.",
  "Rated 5 paws by guests. Humans not consulted.",
  "Management reserves the right to be licked.",
  "Another day, another ball of fur rolling by",
  "Borrowed dogs, real love.",
  "Every dog goes home. The fur stays.",
];

// Link previews can't run the client script, so they get whoever was live when
// the site was built. Diary posts rebuild it most days of a stay anyway.
const liveAtBuild = pickToday(guests.map(({ photo, ...g }) => g), todaySGT()).live[0];
---

<Layout
  ogImage={liveAtBuild ? `/og/${liveAtBuild.id}.jpg` : undefined}
  description={liveAtBuild ? `${liveAtBuild.name} is on the sofa today. Here's the diary.` : undefined}
>
  <Nav />

  <div id="home-app" class="mt-8" hidden></div>

  <noscript>
    <p class="mt-8 text-base leading-relaxed">
      Enable JavaScript to see who's on the sofa today
      {hasPastGuests && (
        <>
          {" "}or <a href="/guests" class="border-b-[1.5px] border-line">browse past guests</a>
        </>
      )}.
    </p>
  </noscript>

  <div class="entrance entrance-delay-2 mt-10 flex gap-4 items-start flex-wrap">
    <div class="w-[134px] h-[154px] rounded-[22px] overflow-hidden flex-none -rotate-[1.5deg] bg-cream card-keyline">
      <img
        src="/images/alan-weiwen-portrait.jpg"
        alt="Alan and Weiwen smiling together"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex-1 min-w-[210px]">
      <div class="font-serif text-[36px] leading-none">Alan &amp; Weiwen</div>
      <p class="mt-[9px] text-base leading-relaxed text-pretty">
      Two humans in Towner with a sunny corner sofa and no dog of our own. Friends and
        neighbours leave their dogs with us for a bit, and this tiny page keeps tabs on
        who's staying today.
      </p>
    </div>
  </div>

  <section id="past-guests-section" hidden>
    <div class="mt-11 border-t-[1.5px] border-line pt-[18px] flex items-baseline justify-between gap-3">
      <div class="font-serif text-[32px] leading-none">Past guests</div>
      <a
        href="/guests"
        class="font-semibold text-[13px] border-[1.5px] border-line px-[13px] py-1.5 rounded-full transition-colors duration-200 hover:bg-lime"
      >
        See all
      </a>
    </div>

    <div id="past-preview-app"></div>
  </section>

  <footer class="entrance entrance-delay-3 mt-12 border-t-[1.5px] border-line pt-[18px]">
    <div id="footer-line" class="font-serif italic text-[22px] leading-[1.2]">{footerLines[0]}</div>
    <script is:inline define:vars={{ footerLines }}>
      // A different line each visit. Runs before the footer's entrance
      // animation starts, so nobody sees the swap.
      document.getElementById("footer-line").textContent =
        footerLines[Math.floor(Math.random() * footerLines.length)];
    </script>
    <div class="mt-2.5 text-xs tracking-[0.1em] uppercase text-label">
    Towner &middot; No dog of our own, just everyone else's
    </div>
  </footer>

  <!-- Hidden bank of pre-optimized cut-outs, one per guest. The client script
       re-parents (moves, doesn't clone) the node it needs into whichever
       card is showing right now. -->
  <div id="photo-bank" class="hidden">
    {guests.map((g) => (
      <div id={`photo-${g.id}`} class="h-full w-full">
        <Cutout photo={g.photo} name={g.name} />
      </div>
    ))}
    <div id="photo-sofa" class="h-full w-full">
      <Image src={sofaCutout} alt="Our sofa, no dog on it" width={1000} class="h-full w-full object-contain" />
    </div>
  </div>

  <script type="application/json" id="guests-data" is:inline set:html={guestsJson} />

  <script is:inline>
    (function () {
      // ---- selection rules — MIRRORS src/lib/guests.ts, keep in sync ----
      function todaySGT() {
        return new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Singapore",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(new Date());
      }

      // Preview helper: ?date=YYYY-MM-DD pretends it's another day, so we can
      // see a takeover before (or after) the dog actually turns up.
      function previewDate() {
        var m = /[?&]date=(\d{4}-\d{2}-\d{2})\b/.exec(location.search);
        return m ? m[1] : null;
      }

      function stayOn(g, todayISO) {
        return g.stays.filter((s) => s.checkIn <= todayISO && todayISO <= s.checkOut)[0];
      }
      // Stays arrive newest first, so the most recent one is simply the first.
      function latestStay(g) {
        return g.stays[0];
      }
      // What the guest did on a given day — the homepage only ever cares
      // about today, however long the stay runs.
      function dayOn(g, todayISO) {
        return g.days.filter((d) => d.iso === todayISO)[0] || { entries: [] };
      }

      function pickToday(guests, todayISO) {
        var live = guests
          .filter((g) => g.showLive && stayOn(g, todayISO))
          .sort((a, b) => {
            var x = stayOn(a, todayISO).checkIn,
              y = stayOn(b, todayISO).checkIn;
            return x < y ? -1 : x > y ? 1 : 0;
          });
        if (live.length > 0) {
          return { state: live.length === 1 ? "one" : "multi", live: live };
        }
        var past = guests
          .filter((g) => latestStay(g).checkOut < todayISO)
          .sort((a, b) => {
            var x = latestStay(a).checkOut,
              y = latestStay(b).checkOut;
            return x < y ? 1 : x > y ? -1 : 0;
          });
        return { state: "vacancy", live: [], lastGuest: past[0] };
      }

      var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      function fmtDay(iso) {
        var parts = iso.split("-").map(Number);
        return parts[2] + " " + MONTHS[parts[1] - 1];
      }
      function stayLabel(s) {
        if (s.checkIn === s.checkOut) return fmtDay(s.checkIn);
        return fmtDay(s.checkIn) + "–" + fmtDay(s.checkOut);
      }

      function nextArrival(guests, todayISO) {
        var todayTime = Date.parse(todayISO + "T00:00:00Z");
        var next = null;
        guests.forEach((g) => {
          if (!g.showLive) return;
          g.stays.forEach((s) => {
            var daysAway = Math.round((Date.parse(s.checkIn + "T00:00:00Z") - todayTime) / 86400000);
            if (daysAway < 1 || daysAway > 4) return;
            if (!next || s.checkIn < next.stay.checkIn) next = { guest: g, stay: s, daysAway: daysAway };
          });
        });
        return next;
      }

      // Each guest's cards stay inside their own hero colour, cycling light
      // to dark, rather than jumping hue card to card — ties the diary back
      // to whoever it's about instead of using a shared whacky rotation.
      function mix(a, b, t) {
        a = a.replace("#", "");
        b = b.replace("#", "");
        var ar = parseInt(a.substr(0, 2), 16), ag = parseInt(a.substr(2, 2), 16), ab = parseInt(a.substr(4, 2), 16);
        var br = parseInt(b.substr(0, 2), 16), bg = parseInt(b.substr(2, 2), 16), bb = parseInt(b.substr(4, 2), 16);
        var r = Math.round(ar + (br - ar) * t), g = Math.round(ag + (bg - ag) * t), bl = Math.round(ab + (bb - ab) * t);
        return "#" + [r, g, bl].map((v) => v.toString(16).padStart(2, "0")).join("");
      }
      function luma(hex) {
        hex = hex.replace("#", "");
        var r = parseInt(hex.substr(0, 2), 16), g = parseInt(hex.substr(2, 2), 16), b = parseInt(hex.substr(4, 2), 16);
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      }
      function guestSkins(base) {
        return [
          { bg: mix(base, "#F7F2E7", 0.72), fg: "#1E2019", accent: mix(base, "#1E2019", 0.35) },
          { bg: base, fg: "#F7F2E7", accent: mix(base, "#F7F2E7", 0.55) },
          { bg: mix(base, "#1E2019", 0.38), fg: "#F7F2E7", accent: mix(base, "#F7F2E7", 0.7) },
          { bg: mix(base, "#1E2019", 0.72), fg: "#F3F1E9", accent: mix(base, "#F7F2E7", 0.7) },
        ];
      }
      var skinIdxByGuest = {};
      function skin(bgColor, id) {
        skinIdxByGuest[id] = skinIdxByGuest[id] || 0;
        var i = skinIdxByGuest[id]++;
        return guestSkins(bgColor)[i % 4];
      }
      function tilt(i) {
        return i % 2 === 0 ? "-1deg" : "1deg";
      }
      var PRINT_MAX_HEIGHT = 420;
      var PRINT_MAT = 7;
      function printWidth(w, h) {
        return Math.round(PRINT_MAX_HEIGHT * (w / h)) + PRINT_MAT * 2;
      }
      function printTilt(i) {
        return i % 2 === 0 ? "1.5deg" : "-1.5deg";
      }
      function noteTilt(i) {
        return i % 2 === 0 ? "-0.4deg" : "0.4deg";
      }
      function fitsPrintMat(text) {
        return text.trim().split(/\s+/).length <= 8;
      }
      var GROUP_WORDS = { 2: "Two", 3: "Three", 4: "Four", 5: "Five", 6: "Six" };
      function groupWord(n) {
        return GROUP_WORDS[n] || String(n);
      }

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      // ---- fit the giant headline to its container ----
      // `reserve` (px) keeps the text clear of the absolutely-positioned
      // "Here today" / "Sofa free" pill that overlaps the headline's top-right
      // corner — otherwise a very long name could fit the container width
      // exactly and still run visually under the pill.
      function fitText(el, reserve) {
        var parent = el.parentElement;
        if (!parent) return;
        var budget = parent.clientWidth - (reserve || 0);
        var cs = getComputedStyle(el);
        var max = parseFloat(cs.fontSize);
        el.style.fontSize = max + "px";
        if (el.scrollWidth <= budget + 1) return;
        var lo = 14,
          hi = max,
          best = lo;
        for (var i = 0; i < 18 && hi - lo > 0.5; i++) {
          var mid = (lo + hi) / 2;
          el.style.fontSize = mid + "px";
          if (el.scrollWidth <= budget + 1) {
            best = mid;
            lo = mid;
          } else {
            hi = mid;
          }
        }
        el.style.fontSize = best + "px";
      }
      window.__tgpFitHeadlines = function () {
        document.querySelectorAll(".fit-headline").forEach((el) => {
          var badge = document.getElementById("hero-badge");
          var reserve = badge && badge.offsetParent ? badge.offsetWidth + 12 : 0;
          fitText(el, reserve);
        });
      };

      // ---- build hero + today-entries markup for the live states ----
      function heroLiveHTML(live, today) {
        var pair = live.length > 1;
        var color = pair ? "#5F6E4F" : live[0].bgColor;
        var name = live.map((d) => d.name).join(" & ");
        var sub = pair
          ? groupWord(live.length) + " dogs, one sofa, no space for humans"
          : esc(live[0].tagline);
        var sizeClass = pair ? "text-[clamp(42px,12.5vw,82px)]" : "text-[clamp(62px,19vw,120px)]";
        var photoH = pair ? "250px" : "310px";

        var chips = [];
        if (!pair) {
          chips.push({ label: stayLabel(stayOn(live[0], today)), bg: "#F7F2E7" });
          if (live[0].badge) chips.push({ label: live[0].badge, bg: "#D8F24E" });
        } else {
          live.forEach((d) => chips.push({ label: d.name + " · " + d.breed, bg: "#F7F2E7" }));
          chips.push({ label: groupWord(live.length) + " dogs, one sofa", bg: "#D8F24E" });
        }

        var chipsHTML = chips
          .map(
            (c) =>
              '<span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink" style="background:' +
              c.bg +
              '">' +
              esc(c.label) +
              "</span>"
          )
          .join("");

        return {
          color: color,
          html:
            '<div class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:' +
            color +
            '">' +
            '<div id="hero-badge" class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full animate-wiggle">Here today</div>' +
            '<div class="w-full"><h1 class="fit-headline ' +
            sizeClass +
            ' max-w-full" id="hero-name">' +
            esc(name) +
            "</h1></div>" +
            '<div class="font-serif italic text-[22px] mt-2" style="color:#E9F7AE">' +
            sub +
            "</div>" +
            '<div class="mt-[14px] flex gap-2 flex-wrap">' +
            chipsHTML +
            "</div>" +
            '<div id="hero-photos" class="flex gap-1.5 items-end -mx-2 mt-[18px]" style="height:' +
            photoH +
            '"></div>' +
            "</div>",
          live: live,
        };
      }

      function heroVacancyHTML(lastGuest, next) {
        var html =
          '<div class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:#5F6E4F">' +
          '<div id="hero-badge" class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full animate-wiggle">Sofa free</div>' +
          '<div class="w-full"><h1 class="fit-headline text-[clamp(62px,19vw,120px)] max-w-full">Vacancy</h1></div>' +
          '<div class="font-serif italic text-[22px] mt-2" style="color:#E9F7AE">The sofa is free. The treats are ready.</div>' +
          '<div id="vacancy-photo" class="h-[265px] mx-[-8px] mt-[18px] animate-drift-slow"></div>' +
          "</div>";

        if (next) {
          html +=
            '<a href="/guests/' +
            esc(next.guest.id) +
            '" class="mt-[18px] flex items-center gap-3.5 bg-[#EBF5C8] card-keyline rounded-[24px] p-[13px_15px] rotate-1 transition-transform duration-250 hover:rotate-0 hover:scale-[1.02]">' +
            '<div id="next-up-photo" class="w-16 h-16 rounded-[17px] overflow-hidden flex-none" style="background:' +
            next.guest.bgColor +
            '"></div>' +
            '<div class="min-w-0">' +
            '<div class="font-semibold text-xs tracking-[0.08em] uppercase" style="color:#4C6B3C">Next up · in ' +
            next.daysAway +
            (next.daysAway === 1 ? " day" : " days") +
            "</div>" +
            '<div class="font-serif text-[27px] leading-tight">' +
            esc(next.guest.name) +
            "</div>" +
            '<div class="text-sm">' +
            esc(next.guest.breed) +
            " · arriving " +
            fmtDay(next.stay.checkIn) +
            "</div></div></a>";
        }

        if (lastGuest) {
          html +=
            '<a href="/guests/' +
            esc(lastGuest.id) +
            '" class="' + (next ? "mt-3" : "mt-[18px]") + ' flex items-center gap-3.5 bg-cream card-keyline rounded-[24px] p-[13px_15px] -rotate-1 transition-transform duration-250 hover:rotate-0 hover:scale-[1.02]">' +
            '<div id="last-seen-photo" class="w-16 h-16 rounded-[17px] overflow-hidden flex-none" style="background:' +
            lastGuest.bgColor +
            '"></div>' +
            '<div class="min-w-0">' +
            '<div class="font-semibold text-xs tracking-[0.08em] uppercase" style="color:#4C6B3C">Last seen here</div>' +
            '<div class="font-serif text-[27px] leading-tight">' +
            esc(lastGuest.name) +
            "</div>" +
            '<div class="text-sm">' +
            esc(lastGuest.breed) +
            " · checked out " +
            fmtDay(latestStay(lastGuest).checkOut) +
            "</div></div></a>";
        }
        return html;
      }

      // Everything here is scoped to TODAY, not to the whole stay: on day six
      // of a ten-day visit the page still answers "what happened today", and
      // every label below stays literally true. Every entry from today shows
      // — no cap — stacked single column so a tall photo card never sits
      // next to a short text-only one and leaves ragged whitespace.
      function entryCardsHTML(live, today) {
        var pair = live.length > 1;
        var raw = [];
        live.forEach((d) =>
          dayOn(d, today).entries.forEach((e) =>
            raw.push({ entryId: e.id, time: e.time, text: e.text, media: e.media, who: d.name, id: d.id, bgColor: d.bgColor, key: today + " " + e.time })
          )
        );
        var cards = raw
          .map((e, i) => {
            var sk = skin(e.bgColor, e.id);
            var darkSkin = luma(sk.bg) < 110;
            var video = e.media.filter((m) => m.kind === "video")[0];
            // A caption goes on the mat only when one print can hold it in a
            // few words. Anything longer, or spread over several prints, gets
            // its own ruled slip underneath — never both.
            var matCaption = !video && e.media.length === 1 && !!e.text && fitsPrintMat(e.text);
            var noteCaption = e.media.length > 0 && !!e.text && !matCaption;
            // Give a slip under one photo or video more room than a portrait
            // print. Under a grid it spans the card.
            var noteWidth =
              e.media.length === 1 ? Math.min(printWidth(e.media[0].width, e.media[0].height) + 120, 500) : null;
            var noteHTML = noteCaption
              ? '<div class="diary-slip diary-slip--tear-' + (i % 3) + ' mt-4 mx-auto" style="' +
                (noteWidth ? "width:min(100%," + noteWidth + "px);" : "") +
                "transform:rotate(" +
                noteTilt(i) +
                ')"><div class="diary-slip-paper" aria-hidden="true"></div>' +
                '<div class="diary-note"><p class="text-[14px] text-ink text-pretty">' +
                esc(e.text) +
                "</p></div></div>"
              : "";
            var mediaHTML = "";
            if (video) {
              var vw = printWidth(video.width, video.height);
              mediaHTML =
                '<div class="diary-print mt-[15px] mx-auto bg-cream card-keyline rounded-[16px] p-[7px]" style="width:min(100%,' +
                vw +
                'px)"><video src="' +
                esc(video.src) +
                '" poster="' +
                esc(video.poster) +
                '" controls preload="metadata" aria-label="' +
                esc(video.alt || e.who + ", " + e.time) +
                '" class="block h-auto w-full rounded-[10px]" style="aspect-ratio:' +
                video.width +
                "/" +
                video.height +
                '"></video></div>' + noteHTML;
            } else if (e.media.length === 1) {
              // A short caption is written into the print's own mat, like a
              // note on a Polaroid's border.
              var w = printWidth(e.media[0].width, e.media[0].height);
              mediaHTML =
                '<div class="diary-print mt-[15px] mx-auto bg-cream card-keyline rounded-[16px] p-[7px]" style="width:min(100%,' +
                w +
                "px);transform:rotate(" +
                printTilt(i) +
                ')">' +
                '<img src="' +
                esc(e.media[0].src) +
                '" alt="' +
                esc(e.media[0].alt || e.who + ", " + e.time) +
                '" width="' +
                e.media[0].width +
                '" height="' +
                e.media[0].height +
                '" loading="lazy" decoding="async" class="block h-auto w-full rounded-[10px]">' +
                (matCaption
                  ? '<p class="mt-[9px] px-1 text-center text-[13.5px] leading-snug text-pretty text-ink/70">' + esc(e.text) + "</p>"
                  : "") +
                "</div>" +
                noteHTML;
            } else if (e.media.length) {
              mediaHTML =
                '<div class="diary-prints' +
                (e.media.length === 2 ? " diary-prints--pair" : "") +
                ' mt-[15px]">' +
                e.media.map(function (photo, photoIndex) {
                  var w = printWidth(photo.width, photo.height);
                  return (
                    '<div class="diary-print block mx-auto bg-cream card-keyline rounded-[16px] p-[7px]" style="width:min(100%,' +
                    w +
                    "px);transform:rotate(" +
                    printTilt(i + photoIndex) +
                    ')">' +
                    '<img src="' +
                    esc(photo.src) +
                    '" alt="' +
                    esc(photo.alt || e.who + ", " + e.time) +
                    '" width="' +
                    photo.width +
                    '" height="' +
                    photo.height +
                    '" loading="lazy" decoding="async" class="block h-auto w-full rounded-[10px]">' +
                    "</div>"
                  );
                }).join("") +
                "</div>" +
                // Several prints have no single mat to write on, so the caption
                // gets its own slip of ruled paper tucked under them.
                noteHTML;
            }
            var textHTML = e.text && !matCaption && !noteCaption
              ? '<p class="' +
                (e.media.length ? "mt-4" : "mt-2") +
                ' text-base leading-relaxed text-pretty">' +
                esc(e.text) +
                "</p>"
              : "";
            return (
              '<div class="card-keyline' +
              (darkSkin ? " card-keyline--dark" : "") +
              ' diary-entry-card' +
              (video ? " diary-entry-card--video" : "") +
              ' rounded-[24px] p-[17px_19px]" style="background:' +
              sk.bg +
              ";color:" +
              sk.fg +
              ";--card-tilt:" +
              tilt(i) +
              '">' +
              '<a href="/guests/' + esc(e.id) + '" class="block diary-entry-link">' +
              '<div class="font-semibold text-xs tracking-[0.08em] uppercase" style="color:' +
              sk.accent +
              '">' +
              esc(e.time) +
              (pair ? " · " + esc(e.who) : "") +
              (isNew(e.id, e.key) ? ' <span class="new-tag ml-1 align-[1px]">New</span>' : "") +
              "</div>" +
              mediaHTML +
              textHTML +
              '</a><entry-reactions data-guest="' + esc(e.id) + '" data-entry="' + esc(e.entryId) + '"></entry-reactions></div>'
            );
          })
          .join("");

        // The teaser always shows the whole of today now, so the only thing
        // worth linking to from here is an earlier day of the same stay —
        // otherwise a guest six days in with nothing written yet today gets
        // no way back to what came before.
        function earlierLabel(d) {
          var hasEarlier = d.days.some((day) => day.iso < today && day.entries.length > 0);
          if (!hasEarlier) return "";
          return pair ? "Read " + esc(d.name) + "&rsquo;s earlier days" : "Read earlier days";
        }

        var more = live
          .map((d) => ({ id: d.id, label: earlierLabel(d) }))
          .filter((m) => m.label);
        var moreHTML = more.length
          ? '<div class="' +
            (raw.length ? "mt-3.5" : "mt-2") +
            ' flex gap-4 flex-wrap">' +
            more
              .map(
                (m) =>
                  '<a href="/guests/' +
                  esc(m.id) +
                  '" class="text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">' +
                  m.label +
                  "</a>"
              )
              .join("") +
            "</div>"
          : "";
        // Nothing written yet today: say so, or the empty space under the
        // hero reads like the page failed to load. Mood follows SGT clock.
        function quietLine() {
          var hour = +new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Singapore", hour: "numeric", hourCycle: "h23" }).format(new Date());
          var who = pair ? "The two of them" : esc(live[0].name);
          var mood = hour < 12 ? "still waking up" : hour < 19 ? "busy chilling" : "knocked out already";
          return "No news yet today. " + who + " " + (pair ? "are " : "is ") + mood + ".";
        }
        var cardsHTML = raw.length
          ? '<div class="mt-5 grid gap-3.5">' + cards + "</div>"
          : '<p class="mt-5 text-base text-label text-pretty">' + quietLine() + "</p>";
        return cardsHTML + moreHTML;
      }

      function pastPreviewHTML(cards) {
        var html = cards
          .map((g, i) => {
            return (
              '<a href="/guests/' +
              esc(g.id) +
              '" class="block rounded-[22px] overflow-hidden transition-transform duration-250 hover:-translate-y-0.5 card-keyline' +
              (luma(g.bgColor) < 110 ? " card-keyline--dark" : "") +
              '" style="background:' +
              g.bgColor +
              '">' +
              '<div class="h-[114px] p-[9px_9px_0]"><div id="past-photo-' +
              i +
              '" class="h-full w-full"></div></div>' +
              '<div class="p-[9px_13px_13px] bg-cream">' +
              '<div class="font-serif text-[22px] leading-none">' +
              esc(g.name) +
              "</div>" +
              '<div class="text-[13px] text-muted">' +
              stayLabel(latestStay(g)) +
              "</div></div></a>"
            );
          })
          .join("");
        return '<div class="mt-3.5 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr))">' + html + "</div>";
      }

      // "New since you last looked" — shares its memory with the guest page
      // (src/pages/guests/[id].astro), keyed by guest, so an entry seen in
      // either place isn't flagged again in the other.
      var seenByGuest = {};
      function seenKeys(id) {
        if (!(id in seenByGuest)) {
          try {
            seenByGuest[id] = JSON.parse(localStorage.getItem("tgp-seen-" + id) || "null");
          } catch (e) {
            seenByGuest[id] = null;
          }
        }
        return seenByGuest[id];
      }
      function isNew(id, key) {
        var seen = seenKeys(id);
        return !!seen && seen.indexOf(key) === -1;
      }
      function markSeen(g) {
        var seen = seenKeys(g.id) || [];
        g.days.forEach((d) =>
          d.entries.forEach((e) => {
            var key = d.iso + " " + e.time;
            // First visit ever: everything counts as seen. After that, only
            // what's on this page (today) — earlier days stay for the diary.
            if ((!seenKeys(g.id) || d.iso === today) && seen.indexOf(key) === -1) seen.push(key);
          })
        );
        try {
          localStorage.setItem("tgp-seen-" + g.id, JSON.stringify(seen));
        } catch (e) {}
      }

      function movePhoto(id, targetEl) {
        var node = document.getElementById("photo-" + id);
        if (node && targetEl) targetEl.appendChild(node);
      }
      // For a dog shown twice on one page (the vacancy "Last seen here" card
      // and the past guests strip), the second spot gets a copy.
      function copyPhoto(id, targetEl) {
        var node = document.getElementById("photo-" + id);
        if (!node || !targetEl) return;
        var copy = node.cloneNode(true);
        copy.removeAttribute("id");
        targetEl.appendChild(copy);
      }

      try {
        var dataEl = document.getElementById("guests-data");
        var guests = JSON.parse(dataEl.textContent);
        var preview = previewDate();
        var today = preview || todaySGT();
        var result = pickToday(guests, today);

        var appEl = document.getElementById("home-app");
        if (result.state === "vacancy") {
          var next = nextArrival(guests, today);
          appEl.innerHTML = heroVacancyHTML(result.lastGuest, next);
          movePhoto("sofa", document.getElementById("vacancy-photo"));
          if (next) copyPhoto(next.guest.id, document.getElementById("next-up-photo"));
          if (result.lastGuest) copyPhoto(result.lastGuest.id, document.getElementById("last-seen-photo"));
        } else {
          var hero = heroLiveHTML(result.live, today);
          appEl.innerHTML = hero.html + entryCardsHTML(result.live, today);
          var photosEl = document.getElementById("hero-photos");
          result.live.forEach((d) => {
            var a = document.createElement("a");
            a.href = "/guests/" + d.id;
            a.className = "block flex-1 min-w-0 h-full animate-drift transition-[filter] duration-200";
            photosEl.appendChild(a);
            movePhoto(d.id, a);
          });
          result.live.forEach(markSeen);
        }
        if (preview) {
          var note = document.createElement("div");
          note.className =
            "mb-3.5 text-xs font-semibold tracking-[0.08em] uppercase border-[1.5px] border-dashed border-line rounded-full px-[13px] py-2 inline-block";
          note.textContent = "Preview · pretending it's " + fmtDay(preview);
          appEl.prepend(note);
        }
        appEl.hidden = false;

        var liveIds = result.live.map((d) => d.id);
        var past = guests
          .filter((g) => latestStay(g).checkOut < today && liveIds.indexOf(g.id) === -1)
          .sort((a, b) => {
            var x = latestStay(a).checkOut,
              y = latestStay(b).checkOut;
            return x < y ? 1 : x > y ? -1 : 0;
          })
          .slice(0, 4);
        var previewEl = document.getElementById("past-preview-app");
        if (past.length > 0) {
          previewEl.innerHTML = pastPreviewHTML(past);
          past.forEach((g, i) => movePhoto(g.id, document.getElementById("past-photo-" + i)));
          var pastSection = document.getElementById("past-guests-section");
          pastSection.classList.add("entrance", "entrance-delay-3");
          pastSection.hidden = false;
        }

        window.__tgpFitHeadlines();
        window.addEventListener("resize", window.__tgpFitHeadlines);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(window.__tgpFitHeadlines);
        }
      } catch (err) {
        console.error("[towner-godpawrents] homepage render failed", err);
        var appEl = document.getElementById("home-app");
        appEl.innerHTML =
          '<div role="status" class="rounded-[24px] bg-cream card-keyline overflow-hidden py-[13px]">' +
          '<div class="diary-note"><p class="text-[15px] text-ink text-pretty">' +
          "Couldn't load today's diary just now. " +
          '<a href="/guests" class="font-semibold border-b-[1.5px] border-line hover:border-ink">Browse past guests</a>.' +
          "</p></div></div>";
        appEl.hidden = false;
      }
    })();
  </script>
</Layout>
