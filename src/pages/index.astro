---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Cutout from "../components/Cutout.astro";
import { cutoutWidth } from "../lib/cutout-width";
import { Image } from "astro:assets";
import sofaCutout from "../assets/sofa-cutout-v2.png";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
  dogNames,
  parseDiary,
  entryMinutes,
  crossPost,
  pastGuests,
  staysNewestFirst,
  warnOnOverlaps,
  dateStr,
  GROUP_HERO,
  todaySGT,
} from "../lib/guests";

// Diary media is referenced from inside the markdown body, so it never
// passes through Astro's markdown image pipeline on its own — glob the
// folder to optimize photos anyway (videos aren't optimized by Astro, just
// resolved to a built URL). Mirrors the same helper in
// src/pages/guests/[id].astro; the homepage teaser needs the same media
// pre-resolved to plain URLs, since the card markup is built client-side.
const diaryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../content/guests/**/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);
const diaryVideos = import.meta.glob<string>("../content/guests/**/*.mp4", {
  eager: true,
  query: "?url",
  import: "default",
});
// ffprobe isn't available at Vercel build time, so prep-video.sh captures the
// encoded dimensions (portrait clips included) as a sidecar JSON file.
const diaryVideoDims = import.meta.glob<{ width: number; height: number }>(
  "../content/guests/**/*.mp4.json",
  { eager: true, import: "default" },
);

function resolveDiaryPhoto(src: string, guestId: string, when: string): ImageMetadata {
  const file = src.split("/").pop()!;
  const key = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[home] ${guestId}, ${when}: no image "${file}" in src/content/guests/ (written as "${src}")`,
    );
  }
  return diaryImages[key].default;
}

function resolveDiaryVideo(
  src: string,
  guestId: string,
  when: string,
): { src: string; poster: string; width: number; height: number } {
  const file = src.split("/").pop()!;
  const key = Object.keys(diaryVideos).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[home] ${guestId}, ${when}: no video "${file}" in src/content/guests/ (written as "${src}")`,
    );
  }
  const dimsKey = Object.keys(diaryVideoDims).find((k) => k.endsWith(`/${file}.json`));
  if (!dimsKey) {
    throw new Error(
      `[home] ${guestId}, ${when}: no "${file}.json" dimensions sidecar — re-run scripts/prep-video.sh`,
    );
  }
  const posterKey = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}.jpg`));
  if (!posterKey) {
    throw new Error(
      `[home] ${guestId}, ${when}: no "${file}.jpg" poster sidecar — re-run scripts/prep-video.sh`,
    );
  }
  const { width, height } = diaryVideoDims[dimsKey];
  return { src: diaryVideos[key], poster: diaryImages[posterKey].default.src, width, height };
}

const entries = await getCollection("guests");

const guests = entries.map((e) => {
  const stays = staysNewestFirst(
    e.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
  );
  warnOnOverlaps(e.id, stays);
  return {
    id: e.id,
    name: e.data.name,
    dogs: dogNames(e.data.name),
    breed: e.data.breed,
    tagline: e.data.tagline ?? "",
    badge: e.data.badge ?? "",
    whenCalled: e.data.whenCalled ?? "",
    sounds: e.data.sounds,
    bgColor: e.data.bgColor,
    showLive: e.data.showLive,
    photo: e.data.photo,
    stays,
    days: parseDiary(e.body ?? "", stays, e.id),
  };
});
crossPost(guests);
const nameOf = (id: string) => guests.find((g) => g.id === id)!.name;

// Sent to the client so it can work out who's "here today" in the
// Asia/Singapore timezone at load time — see the inline script below.
// Cut-outs aren't included here; they're pre-optimized at build time into the
// inert templates and the client inserts only the portraits it needs,
// so no image processing has to happen in the browser. Diary media IS
// included now (as plain resolved URLs, since the client builds the card
// markup itself) — the teaser shows today's whole day, media and all.
const guestsForClient = await Promise.all(
  guests.map(async ({ photo, days, ...rest }) => ({
    ...rest,
    days: await Promise.all(
      days.map(async (d) => ({
        iso: d.iso,
        entries: await Promise.all(
          d.entries.map(async (e) => {
            return {
              id: e.id,
              time: e.time,
              mins: entryMinutes(e.time),
              from: e.from ?? null,
              withNames: e.with.map(nameOf),
              text: e.text,
              media: await Promise.all(e.media.map(async (m) => {
                if (m.kind === "video") {
                  const video = resolveDiaryVideo(m.src, rest.id, `${d.label} ${e.time}`);
                  return { kind: "video" as const, ...video, alt: m.alt };
                }
                const meta = resolveDiaryPhoto(m.src, rest.id, `${d.label} ${e.time}`);
                const img = await getImage({ src: meta, width: Math.min(meta.width, 1160) });
                return {
                  kind: "photo" as const,
                  src: img.src,
                  width: img.attributes.width,
                  height: img.attributes.height,
                  alt: m.alt,
                };
              })),
            };
          }),
        ),
      })),
    ),
  })),
);
const groupHeroJson = JSON.stringify(GROUP_HERO);
const guestsJson = JSON.stringify(guestsForClient).replace(/</g, "\\u003c");

const hasPastGuests = pastGuests(guests, todaySGT()).length > 0;

// Link previews don't say who's here today: chat apps cache them for weeks,
// so a build-time "today" goes stale in the thread. The Layout's default
// lineup of every dog so far never does.
---

<Layout>
  <Nav />

  <div id="home-app" class="mt-8" hidden></div>

  <noscript>
    <p class="mt-8 text-base leading-relaxed">
      Enable JavaScript to see who's on the sofa today
      {hasPastGuests && (
        <>
          {" "}or <a href="/guests" class="border-b-[1.5px] border-line">browse past guests</a>
        </>
      )}.
    </p>
  </noscript>

  <div class="entrance entrance-delay-2 mt-10 flex gap-4 items-start flex-wrap">
    <div class="w-[134px] h-[154px] rounded-[24px] overflow-hidden flex-none -rotate-[1.5deg] bg-cream card-keyline">
      <img
        src="/images/alan-weiwen-portrait.jpg"
        alt="Alan and Weiwen smiling together"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex-1 min-w-[210px]">
      <h2 class="font-serif text-[36px] leading-none">Alan &amp; Weiwen</h2>
      <p class="mt-[9px] text-base leading-relaxed text-pretty">
      Two humans in Towner with a sunny corner sofa and no dog of our own. Friends and
        neighbours leave their dogs with us for a bit, and this tiny page keeps tabs on
        who's staying today.
      </p>
    </div>
  </div>

  <section id="past-guests-section" hidden>
    <div class="mt-11 border-t-[1.5px] border-line pt-[18px] flex items-baseline justify-between gap-3">
      <h2 class="font-serif text-[32px] leading-none">Past guests</h2>
      <a
        href="/guests"
        class="font-semibold text-[13px] border-[1.5px] border-line px-[13px] py-1.5 rounded-full transition-colors duration-200 hover:border-ink"
      >
        See all
      </a>
    </div>

    <div id="past-preview-app"></div>
  </section>

  <Footer />

  <!-- Templates keep unused portraits from downloading. -->
  {guests.map((g) => (
    <template id={`photo-${g.id}`}>
      <div class="h-full w-full">
        <Cutout photo={g.photo} name={g.name} />
      </div>
    </template>
  ))}
  <template id="photo-sofa">
    <div class="h-full w-full">
      <Image src={sofaCutout} alt="Our sofa, no dog on it" width={640} widths={[320, 640, 960, 1280]} sizes="(min-width: 700px) 628px, calc(100vw - 72px)" class="h-full w-full object-contain" />
    </div>
  </template>

  <dialog id="print-viewer" class="print-viewer" aria-label="Photo">
    <form method="dialog">
      <button class="print-viewer-close" aria-label="Close">×</button>
    </form>
    <img alt="" />
  </dialog>

  <script is:inline>
    (function () {
      // Tap a print to see it big, same as on a dog's page. The cards are
      // drawn after this runs, so listen on the page rather than each print.
      var viewer = document.getElementById("print-viewer");
      var big = viewer.querySelector("img");
      document.addEventListener("click", function (e) {
        var btn = e.target.closest && e.target.closest("button.diary-print-tap");
        if (!btn) return;
        var img = btn.querySelector("img");
        big.src = img.currentSrc || img.src;
        big.alt = img.alt;
        viewer.showModal();
      });
      // A tap on the dim backdrop closes it too, not just the ×.
      viewer.addEventListener("click", function (e) {
        if (e.target === viewer || e.target === big) viewer.close();
      });
    })();
  </script>

  <script is:inline set:html={`window.__tgpCutoutWidth = ${cutoutWidth.toString()};`} />
  <script type="application/json" id="guests-data" is:inline set:html={guestsJson} />
  <script type="application/json" id="group-hero" is:inline set:html={groupHeroJson} />

  <script is:inline>
    (function () {
      // ---- selection rules — MIRRORS src/lib/guests.ts, keep in sync ----
      function todaySGT() {
        return new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Singapore",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(new Date());
      }

      // Preview helper: ?date=YYYY-MM-DD pretends it's another day, so we can
      // see a takeover before (or after) the dog actually turns up.
      function previewDate() {
        var m = /[?&]date=(\d{4}-\d{2}-\d{2})\b/.exec(location.search);
        return m ? m[1] : null;
      }

      var groupHero = {};

      function stayOn(g, todayISO) {
        return g.stays.filter((s) => s.checkIn <= todayISO && todayISO <= s.checkOut)[0];
      }
      // The newest stay that's already over. Not simply the newest stay: a
      // dog with a return visit booked would otherwise date from the future.
      // Stays arrive newest first.
      function lastEndedStay(g, todayISO) {
        return g.stays.filter((s) => s.checkOut < todayISO)[0];
      }
      // Guests with a stay behind them, most recently departed first. Each
      // carries that stay as `ended`.
      function pastGuests(guests, todayISO) {
        return guests
          .filter((g) => lastEndedStay(g, todayISO))
          .map((g) => Object.assign({}, g, { ended: lastEndedStay(g, todayISO) }))
          .sort((a, b) => (a.ended.checkOut < b.ended.checkOut ? 1 : a.ended.checkOut > b.ended.checkOut ? -1 : 0));
      }
      // What the guest did on a given day — the homepage only ever cares
      // about today, however long the stay runs.
      function dayOn(g, todayISO) {
        return g.days.filter((d) => d.iso === todayISO)[0] || { entries: [] };
      }

      function pickToday(guests, todayISO) {
        var live = guests
          .filter((g) => g.showLive && stayOn(g, todayISO))
          .sort((a, b) => {
            var x = stayOn(a, todayISO).checkIn,
              y = stayOn(b, todayISO).checkIn;
            return x < y ? -1 : x > y ? 1 : 0;
          });
        if (live.length > 0) {
          return { state: live.length === 1 ? "one" : "multi", live: live };
        }
        return { state: "vacancy", live: [], lastGuest: pastGuests(guests, todayISO)[0] };
      }

      var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      function fmtDay(iso) {
        var parts = iso.split("-").map(Number);
        return parts[2] + " " + MONTHS[parts[1] - 1];
      }
      function stayLabel(s) {
        if (s.checkIn === s.checkOut) return fmtDay(s.checkIn);
        // Same month: "13–23 Sep", not "13 Sep – 23 Sep".
        if (s.checkIn.slice(0, 7) === s.checkOut.slice(0, 7)) {
          return Number(s.checkIn.slice(8)) + "–" + fmtDay(s.checkOut);
        }
        return fmtDay(s.checkIn) + " – " + fmtDay(s.checkOut);
      }
      // "Day 6 of 11", so an owner mid-stay knows where they are in it.
      // A one-night stay has nothing to count.
      function stayDay(s, todayISO) {
        if (!s || s.checkIn === s.checkOut) return "";
        var dayMs = 86400000;
        var n = Math.round((Date.parse(todayISO) - Date.parse(s.checkIn)) / dayMs) + 1;
        var total = Math.round((Date.parse(s.checkOut) - Date.parse(s.checkIn)) / dayMs) + 1;
        return "Day " + n + " of " + total;
      }
      // Checkout day: the dog may already be home by the time anyone looks,
      // so "Here today" would be a fib by evening.
      function goingHome(g, todayISO) {
        var s = stayOn(g, todayISO);
        return !!s && s.checkOut === todayISO && s.checkIn !== todayISO;
      }

      function nextArrival(guests, todayISO) {
        var todayTime = Date.parse(todayISO + "T00:00:00Z");
        var next = null;
        guests.forEach((g) => {
          if (!g.showLive) return;
          g.stays.forEach((s) => {
            var daysAway = Math.round((Date.parse(s.checkIn + "T00:00:00Z") - todayTime) / 86400000);
            if (daysAway < 1 || daysAway > 4) return;
            if (!next || s.checkIn < next.stay.checkIn) next = { guest: g, stay: s, daysAway: daysAway };
          });
        });
        return next;
      }

      // Each guest's cards stay inside their own hero colour, cycling light
      // to dark, rather than jumping hue card to card — ties the diary back
      // to whoever it's about instead of using a shared whacky rotation.
      function mix(a, b, t) {
        a = a.replace("#", "");
        b = b.replace("#", "");
        var ar = parseInt(a.substr(0, 2), 16), ag = parseInt(a.substr(2, 2), 16), ab = parseInt(a.substr(4, 2), 16);
        var br = parseInt(b.substr(0, 2), 16), bg = parseInt(b.substr(2, 2), 16), bb = parseInt(b.substr(4, 2), 16);
        var r = Math.round(ar + (br - ar) * t), g = Math.round(ag + (bg - ag) * t), bl = Math.round(ab + (bb - ab) * t);
        return "#" + [r, g, bl].map((v) => v.toString(16).padStart(2, "0")).join("");
      }
      function luma(hex) {
        hex = hex.replace("#", "");
        var r = parseInt(hex.substr(0, 2), 16), g = parseInt(hex.substr(2, 2), 16), b = parseInt(hex.substr(4, 2), 16);
        return 0.2126 * r + 0.7152 * g + 0.0722 * b;
      }
      function guestSkins(base) {
        return [
          { bg: mix(base, "#F7F2E7", 0.72), fg: "#1E2019", accent: mix(base, "#1E2019", 0.35) },
          { bg: base, fg: "#F7F2E7", accent: "#F7F2E7" },
          { bg: mix(base, "#1E2019", 0.38), fg: "#F7F2E7", accent: mix(base, "#F7F2E7", 0.7) },
          { bg: mix(base, "#1E2019", 0.72), fg: "#F3F1E9", accent: mix(base, "#F7F2E7", 0.7) },
        ];
      }
      var skinIdxByGuest = {};
      function skin(bgColor, id) {
        skinIdxByGuest[id] = skinIdxByGuest[id] || 0;
        var i = skinIdxByGuest[id]++;
        return guestSkins(bgColor)[i % 4];
      }
      function tilt(i) {
        return i % 2 === 0 ? "-1deg" : "1deg";
      }
      var PRINT_MAX_HEIGHT = 420;
      var PRINT_MAT = 7;
      var VIDEO_MAX_HEIGHT = 560;
      function printWidth(w, h, maxHeight) {
        return Math.round((maxHeight || PRINT_MAX_HEIGHT) * (w / h)) + PRINT_MAT * 2;
      }
      function printTilt(i) {
        return i % 2 === 0 ? "1.5deg" : "-1.5deg";
      }
      function noteTilt(i) {
        return i % 2 === 0 ? "-0.4deg" : "0.4deg";
      }
      function videoNoteTilt(i) {
        return i % 2 === 0 ? "-1.5deg" : "1.5deg";
      }
      function fitsPrintMat(text) {
        return text.trim().split(/\s+/).length <= 8;
      }
      var GROUP_WORDS = { 2: "Two", 3: "Three", 4: "Four", 5: "Five", 6: "Six" };
      function groupWord(n) {
        return GROUP_WORDS[n] || String(n);
      }

      // MIRRORS listNames in src/lib/guests.ts.
      function listNames(names) {
        return names.length > 1 ? names.slice(0, -1).join(", ") + " & " + names[names.length - 1] : names[0];
      }

      // Every dog on the sofa: dogs from one home share a guest, so count
      // dogs, not guests, whenever the words say how many.
      function dogsIn(live) {
        return live.reduce((all, g) => all.concat(g.dogs), []);
      }

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      // ---- fit the giant headline to its container ----
      // `reserve` (px) keeps the text clear of the absolutely-positioned
      // "Here today" / "Sofa's empty" pill that overlaps the headline's top-right
      // corner — otherwise a very long name could fit the container width
      // exactly and still run visually under the pill.
      function fitText(el, reserve) {
        var parent = el.parentElement;
        if (!parent) return;
        var budget = parent.clientWidth - (reserve || 0);
        var cs = getComputedStyle(el);
        var max = parseFloat(cs.fontSize);
        el.style.fontSize = max + "px";
        if (el.scrollWidth <= budget + 1) return;
        var lo = 14,
          hi = max,
          best = lo;
        for (var i = 0; i < 18 && hi - lo > 0.5; i++) {
          var mid = (lo + hi) / 2;
          el.style.fontSize = mid + "px";
          if (el.scrollWidth <= budget + 1) {
            best = mid;
            lo = mid;
          } else {
            hi = mid;
          }
        }
        el.style.fontSize = best + "px";
      }
      window.__tgpFitHeadlines = function () {
        document.querySelectorAll(".fit-headline").forEach((el) => {
          var badge = document.getElementById("hero-badge");
          // A headline that starts below the pill has the full width to itself.
          var clear = el.classList.contains("fit-headline--clear");
          var reserve = !clear && badge && badge.offsetParent ? badge.offsetWidth + 12 : 0;
          fitText(el, reserve);
        });
      };

      // ---- build hero + today-entries markup for the live states ----
      function heroLiveHTML(live, today) {
        var pair = live.length > 1;
        var color = pair ? "#5F6E4F" : live[0].bgColor;
        var dogs = dogsIn(live);
        // Two or more dogs: one name per line, starting below the "Here today"
        // pill, so each name gets the full width instead of shrinking to fit
        // everyone on one line beside the pill.
        var stacked = dogs.length > 1;
        var nameHTML = stacked
          ? dogs
              .map((n, i) => esc(n) + (i < dogs.length - 2 ? "," : i === dogs.length - 2 ? " &amp;" : ""))
              .join("<br>")
          : esc(live[0].name);
        var group = (pair && groupHero[live.map((d) => d.id).sort().join("+")]) || {};
        var sub = pair
          ? group.tagline ? esc(group.tagline) : groupWord(dogs.length) + " dogs on the sofa. Humans on the floor."
          : esc(live[0].tagline);
        var sizeClass = stacked
          ? "text-[clamp(56px,17vw,96px)] mt-[30px] fit-headline--clear"
          : "text-[clamp(62px,19vw,120px)]";
        var photoH = live.length === 2 ? "clamp(240px, 60vw, 320px)" : pair ? "250px" : "310px";
        var leaving = live.every((d) => goingHome(d, today));

        var chips = [];
        if (!pair) {
          var stay = stayOn(live[0], today);
          var href = "/guests/" + live[0].id;
          chips.push({ label: stayLabel(stay), href: href });
          if (stayDay(stay, today)) chips.push({ label: stayDay(stay, today), href: href });
          if (live[0].badge) chips.push({ label: live[0].badge, tape: true });
        } else {
          live.forEach((d) => {
            var day = goingHome(d, today) ? "going home today" : stayDay(stayOn(d, today), today).toLowerCase();
            chips.push({ label: d.name + " · " + (day || d.breed), href: "/guests/" + d.id });
          });
          chips.push({ label: group.badge || "Vacuum on overtime", tape: true });
        }

        var chipsHTML = chips
          .map(
            (c) =>
              // The cut-outs are pat buttons now, so the dog's own pills
              // are the way into its diary.
              (c.href
                ? '<a href="' + esc(c.href) + '" class="fact-chip transition-transform duration-250 hover:scale-[1.04]">' + esc(c.label) + "</a>"
                : (c.tape ? '<span class="badge-tape">' : '<span class="fact-chip">') + esc(c.label) + "</span>")
          )
          .join("");

        return {
          color: color,
          html:
            '<div id="hero-card" class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:' +
            color +
            '">' +
            '<div id="hero-badge" class="absolute top-[18px] right-[18px] status-tag animate-wiggle">' +
            (leaving ? "Going home today" : "Here today") +
            "</div>" +
            '<div class="w-full"><h1 class="fit-headline ' +
            sizeClass +
            ' max-w-full" id="hero-name">' +
            nameHTML +
            "</h1></div>" +
            '<div class="font-serif italic text-[22px] mt-2 text-lime-soft">' +
            sub +
            "</div>" +
            '<div class="mt-[14px] flex gap-2 flex-wrap">' +
            chipsHTML +
            "</div>" +
            '<div id="hero-photos" class="flex gap-1.5 items-end -mx-2 mt-[18px]' + (live.length === 2 ? ' scrapbook-buddies' : '') + '" style="height:' +
            photoH +
            '"></div>' +
            "</div>",
          live: live,
        };
      }

      function heroVacancyHTML(lastGuest, next) {
        var html =
          '<div id="hero-card" class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:#5F6E4F">' +
          '<div id="hero-badge" class="absolute top-[18px] right-[18px] status-tag animate-wiggle">Sofa&#39;s empty</div>' +
          '<div class="w-full"><h1 class="fit-headline text-[clamp(62px,19vw,120px)] max-w-full">No dog today</h1></div>' +
          '<div class="font-serif italic text-[22px] mt-2 text-lime-soft">The vacuum gets a day off. It&#39;s weirdly quiet.</div>' +
          '<button type="button" id="vacancy-photo" aria-label="Look down the side of the sofa" class="block w-[calc(100%+16px)] h-[265px] mx-[-8px] mt-[18px] animate-drift-slow cursor-pointer rounded-[24px] focus-visible:outline-2 focus-visible:outline-lime"></button>' +
          "</div>";

        if (next) {
          html +=
            '<a href="/guests/' +
            esc(next.guest.id) +
            '" class="mt-[18px] flex items-center gap-3.5 border-[1.5px] border-dashed border-line rounded-[24px] p-[13px_15px] rotate-1 transition-transform duration-250 hover:rotate-0 hover:scale-[1.02]">' +
            '<div id="next-up-photo" class="w-16 h-16 rounded-[17px] overflow-hidden flex-none" style="background:' +
            next.guest.bgColor +
            '"></div>' +
            '<div class="min-w-0">' +
            '<div class="font-semibold text-xs tracking-[0.08em] uppercase text-moss">Next up · in ' +
            next.daysAway +
            (next.daysAway === 1 ? " day" : " days") +
            "</div>" +
            '<div class="font-serif text-[27px] leading-tight">' +
            esc(next.guest.name) +
            "</div>" +
            '<div class="text-sm">' +
            esc(next.guest.breed) +
            " · arriving " +
            fmtDay(next.stay.checkIn) +
            "</div></div></a>";
        }

        if (lastGuest) {
          html +=
            '<a href="/guests/' +
            esc(lastGuest.id) +
            '" class="' + (next ? "mt-3" : "mt-[18px]") + ' flex items-center gap-3.5 bg-cream card-keyline rounded-[24px] p-[13px_15px] -rotate-1 transition-transform duration-250 hover:rotate-0 hover:scale-[1.02]">' +
            '<div id="last-seen-photo" class="w-16 h-16 rounded-[17px] overflow-hidden flex-none" style="background:' +
            lastGuest.bgColor +
            '"></div>' +
            '<div class="min-w-0">' +
            '<div class="font-semibold text-xs tracking-[0.08em] uppercase text-moss">Last seen here</div>' +
            '<div class="font-serif text-[27px] leading-tight">' +
            esc(lastGuest.name) +
            "</div>" +
            '<div class="text-sm">' +
            esc(lastGuest.breed) +
            " · checked out " +
            fmtDay(lastGuest.ended.checkOut) +
            "</div></div></a>";
        }
        return html;
      }

      // Everything here is scoped to TODAY, not to the whole stay: on day six
      // of a ten-day visit the page still answers "what happened today", and
      // every label below stays literally true. Every entry from today shows
      // — no cap — stacked single column so a tall photo card never sits
      // next to a short text-only one and leaves ragged whitespace.
      function entryCardsHTML(live, today) {
        var pair = live.length > 1;
        var raw = [];
        live.forEach((d) =>
          dayOn(d, today).entries.forEach((e) => {
            // A shared entry already shows under the dog it's written for,
            // so skip the copy when that dog is here too.
            if (e.from && live.some((o) => o.id === e.from)) return;
            raw.push({ entryId: e.id, time: e.time, mins: e.mins, text: e.text, media: e.media, who: [d.name].concat(e.withNames).join(" & "), shared: e.withNames.length > 0, owner: e.from || d.id, id: d.id, bgColor: d.bgColor, key: today + " " + e.time });
          })
        );
        // Two dogs share one day: merge their entries newest first, like
        // each dog's own diary. Stable sort keeps the written order on ties.
        if (pair) raw.sort((a, b) => b.mins - a.mins);
        var cards = raw
          .map((e, i) => {
            // A shared entry wears Sofa Green, the two-dog hero's colour,
            // rather than either dog's.
            var sk = e.shared ? guestSkins("#5F6E4F")[1] : skin(e.bgColor, e.id);
            var darkSkin = luma(sk.bg) < 110;
            var video = e.media.filter((m) => m.kind === "video")[0];
            // A caption goes on the mat only when one print can hold it in a
            // few words. Anything longer, or spread over several prints, gets
            // its own ruled slip underneath — never both.
            var matCaption = !video && e.media.length === 1 && !!e.text && fitsPrintMat(e.text);
            var noteCaption = e.media.length > 0 && !!e.text && !matCaption;
            // Give a slip under one photo or video more room than a portrait
            // print. Under a grid it spans the card.
            var noteWidth =
              e.media.length === 1
                ? Math.min(printWidth(e.media[0].width, e.media[0].height, video ? VIDEO_MAX_HEIGHT : 0) + 120, 500)
                : null;
            var noteHTML = noteCaption
              ? '<div class="diary-slip diary-slip--tear-' + (i % 3) + ' mt-4 mx-auto" style="' +
                (noteWidth ? "width:min(100%," + noteWidth + "px);" : "") +
                "transform:rotate(" +
                (video ? videoNoteTilt(i) : noteTilt(i)) +
                ')"><div class="diary-slip-paper" aria-hidden="true"></div>' +
                '<div class="diary-note"><p class="slip-caption">' +
                esc(e.text).replace(/~~([^~]+)~~/g, "<del>$1</del>") +
                "</p></div></div>"
              : "";
            var mediaHTML = "";
            if (video) {
              var vw = printWidth(video.width, video.height, VIDEO_MAX_HEIGHT);
              mediaHTML =
                '<div class="diary-print mt-[15px]" style="width:min(100%,' +
                vw +
                'px)"><video src="' +
                esc(video.src) +
                '" poster="' +
                esc(video.poster) +
                '" controls preload="metadata" aria-label="' +
                esc(video.alt || e.who + ", " + e.time) +
                '" class="print-media" style="aspect-ratio:' +
                video.width +
                "/" +
                video.height +
                '"></video></div>' + noteHTML;
            } else if (e.media.length === 1) {
              // A short caption is written into the print's own mat, like a
              // note on a Polaroid's border.
              var w = printWidth(e.media[0].width, e.media[0].height);
              mediaHTML =
                '<div class="diary-print mt-[15px]" style="width:min(100%,' +
                w +
                "px);transform:rotate(" +
                printTilt(i) +
                ')">' +
                '<button type="button" aria-label="Enlarge photo" class="diary-print-tap block mx-auto w-full cursor-zoom-in">' +
                '<img src="' +
                esc(e.media[0].src) +
                '" alt="' +
                esc(e.media[0].alt || e.who + ", " + e.time) +
                '" width="' +
                e.media[0].width +
                '" height="' +
                e.media[0].height +
                '" loading="lazy" decoding="async" class="print-media"></button>' +
                (matCaption
                  ? '<p class="print-caption">' + esc(e.text).replace(/~~([^~]+)~~/g, "<del>$1</del>") + "</p>"
                  : "") +
                "</div>" +
                noteHTML;
            } else if (e.media.length) {
              mediaHTML =
                '<div class="diary-prints' +
                (e.media.length === 2 ? " diary-prints--pair" : e.media.length === 4 ? " diary-prints--quad" : "") +
                ' mt-[15px]">' +
                e.media.map(function (photo, photoIndex) {
                  var w = printWidth(photo.width, photo.height);
                  return (
                    '<button type="button" aria-label="Enlarge photo" class="diary-print diary-print-tap cursor-zoom-in" style="width:min(100%,' +
                    w +
                    "px);transform:rotate(" +
                    printTilt(i + photoIndex) +
                    ')">' +
                    '<img src="' +
                    esc(photo.src) +
                    '" alt="' +
                    esc(photo.alt || e.who + ", " + e.time) +
                    '" width="' +
                    photo.width +
                    '" height="' +
                    photo.height +
                    '" loading="lazy" decoding="async" class="print-media">' +
                    "</button>"
                  );
                }).join("") +
                "</div>" +
                // Several prints have no single mat to write on, so the caption
                // gets its own slip of ruled paper tucked under them.
                noteHTML;
            }
            var textHTML = e.text && !matCaption && !noteCaption
              ? '<p class="' +
                (e.media.length ? "mt-4" : "mt-2") +
                ' text-base leading-relaxed text-pretty">' +
                esc(e.text).replace(/~~([^~]+)~~/g, "<del>$1</del>") +
                "</p>"
              : "";
            return (
              '<div class="card-keyline' +
              (darkSkin ? " card-keyline--dark" : "") +
              ' diary-entry-card' +
              (video ? " diary-entry-card--video" : "") +
              ' entry-surface entry-surface--compact" style="background:' +
              sk.bg +
              ";color:" +
              sk.fg +
              ";--card-tilt:" +
              tilt(i) +
              '">' +
              // The time is the link, stretched over the card so the whole card
              // opens this entry in the dog's diary, while prints and video sit
              // above it and keep their own taps.
              '<div class="font-semibold text-xs tracking-[0.08em] uppercase" style="color:' +
              sk.accent +
              '"><a href="/guests/' + esc(e.owner) + '#entry-' + esc(e.entryId) + '" class="diary-entry-link" aria-label="' +
              esc(e.who + "'s diary, " + e.time) +
              '">' +
              esc(e.time) +
              (pair || e.shared ? " · " + esc(e.who) : "") +
              "</a>" +
              (isNew(e.id, e.key) ? ' <span class="new-tag ml-1 align-[1px]">New</span>' : "") +
              "</div>" +
              mediaHTML +
              textHTML +
              '<entry-reactions data-guest="' + esc(e.owner) + '" data-entry="' + esc(e.entryId) + '"></entry-reactions></div>'
            );
          })
          .join("");

        // The way from the teaser to everything else: each live dog's whole
        // diary, shown every day so it's findable even on day one.
        var more = live.map((d) => ({ id: d.id, label: esc(d.name) + "&rsquo;s full diary" }));
        // A solid ink chip, the heaviest thing under the cards: on a quiet day
        // it's the only way from here to the rest of the stay.
        var moreHTML = more.length
          ? '<div class="mt-5 flex gap-2.5 flex-wrap">' +
            more
              .map(
                (m) =>
                  '<a href="/guests/' +
                  esc(m.id) +
                  '" class="day-chip day-chip--exit">' +
                  m.label +
                  "</a>"
              )
              .join("") +
            "</div>"
          : "";
        // Nothing written yet today: say so, or the empty space under the
        // hero reads like the page failed to load. Mood follows SGT clock.
        function quietLine() {
          var hour = +new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Singapore", hour: "numeric", hourCycle: "h23" }).format(new Date());
          var dogs = dogsIn(live);
          var who = pair ? "The " + groupWord(dogs.length).toLowerCase() + " of them" : esc(live[0].name);
          var leaving = live.every((d) => goingHome(d, today));
          var mood = leaving
            ? "making the most of the sofa"
            : hour < 12 ? "still waking up" : hour < 19 ? "busy chilling" : "knocked out already";
          return "No news yet today. " + who + " " + (dogs.length > 1 ? "are " : "is ") + mood + ".";
        }
        var cardsHTML = raw.length
          ? // Just a count, no date: dates are how the diary files things.
            '<div class="mt-5 border-t-[1.5px] border-line pt-3 font-semibold text-xs tracking-[0.08em] uppercase text-label">' +
            raw.length + (raw.length === 1 ? " moment" : " moments") +
            "</div>" +
            '<div class="mt-3.5 grid gap-3.5">' + cards + "</div>"
          : // A note left on the table, torn from the same pad as the captions,
            // so a quiet day reads as news rather than a page that didn't load.
            '<div class="diary-slip diary-slip--tear-1 mt-5 w-[min(100%,440px)]" style="transform:rotate(-0.4deg)">' +
            '<div class="diary-slip-paper" aria-hidden="true"></div>' +
            '<div class="diary-note"><p class="text-base text-ink text-pretty">' +
            quietLine() +
            "</p></div></div>";
        return cardsHTML + moreHTML;
      }

      function pastPreviewHTML(cards) {
        var html = cards
          .map((g, i) => {
            return (
              '<a href="/guests/' +
              esc(g.id) +
              '" class="dog-card block rounded-[24px] overflow-hidden transition-all duration-250 hover:-translate-y-0.5 card-keyline ' + (i % 2 ? "rotate-1" : "-rotate-1") +
              (luma(g.bgColor) < 110 ? " card-keyline--dark" : "") +
              '" style="background:' +
              g.bgColor +
              '">' +
              '<div class="h-[114px] p-[9px_9px_0]"><div id="past-photo-' +
              i +
              '" class="h-full w-full"></div></div>' +
              '<div class="p-[9px_13px_13px] bg-cream">' +
              '<div class="font-serif text-[22px] leading-none">' +
              esc(g.name) +
              "</div>" +
              '<div class="text-[13px] text-muted">' +
              stayLabel(g.ended) +
              "</div></div></a>"
            );
          })
          .join("");
        return '<div class="mt-3.5 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr))">' + html + "</div>";
      }

      // "New since you last looked" — shares its memory with the guest page
      // (src/pages/guests/[id].astro), keyed by guest, so an entry seen in
      // either place isn't flagged again in the other.
      var seenByGuest = {};
      function seenKeys(id) {
        if (!(id in seenByGuest)) {
          try {
            seenByGuest[id] = JSON.parse(localStorage.getItem("tgp-seen-" + id) || "null");
          } catch (e) {
            seenByGuest[id] = null;
          }
        }
        return seenByGuest[id];
      }
      function isNew(id, key) {
        var seen = seenKeys(id);
        return !!seen && seen.indexOf(key) === -1;
      }
      function markSeen(g) {
        var seen = seenKeys(g.id) || [];
        g.days.forEach((d) =>
          d.entries.forEach((e) => {
            var key = d.iso + " " + e.time;
            // First visit ever: everything counts as seen. After that, only
            // what's on this page (today) — earlier days stay for the diary.
            if ((!seenKeys(g.id) || d.iso === today) && seen.indexOf(key) === -1) seen.push(key);
          })
        );
        try {
          localStorage.setItem("tgp-seen-" + g.id, JSON.stringify(seen));
        } catch (e) {}
      }

      // ---- easter eggs ----
      // What turned up around the flat after the dogs went home.
      var FOUND = [
        "The vacuum, jammed with Luna's fur. Or Guapo's. Hard to tell.",
        "A treat from a game of Find it. Tiny missed one.",
        "One torn plushie. Alan is learning to sew.",
        "Fur under the TV console.",
        "Fur in every corner of the service yard.",
        "A fur tumbleweed, rolling across the floor like the Wild West.",
        "Guapo's chew. We forgot to give it back.",
        "Egg snacks in the freezer. The dog went home before we finished them.",
      ];

      // Replays a one-shot animation, even mid-way through the last one.
      function replay(el, cls) {
        el.classList.remove(cls);
        void el.offsetWidth;
        el.classList.add(cls);
      }

      // A torn slip set down on the hero, swapped for a fresh one each time.
      function heroNote(text) {
        var card = document.getElementById("hero-card");
        var note = card.querySelector(".hero-note");
        if (!note) {
          note = document.createElement("div");
          note.className = "hero-note diary-slip diary-slip--tear-2";
          note.setAttribute("role", "status");
          note.innerHTML = '<div class="diary-slip-paper" aria-hidden="true"></div><div class="diary-note"><p></p></div>';
          card.appendChild(note);
        }
        note.querySelector("p").textContent = text;
        note.style.setProperty("--note-hold", 1200 + text.length * 25 + "ms");
        replay(note, "hero-note-pop");
      }

      function sizeHero(img, targetEl) {
        img.sizes = window.__tgpCutoutWidth(targetEl.clientHeight, targetEl.clientWidth, img.width / img.height) + "px";
      }

      function insertPhoto(id, targetEl, sizes = "160px", hero = false, priority = "auto") {
        var node = document.getElementById("photo-" + id);
        if (!node || !targetEl) return;
        var copy = node.content.cloneNode(true);
        var img = copy.querySelector("img");
        if (img && hero) {
          sizeHero(img, targetEl);
          img.loading = "eager";
          img.fetchPriority = priority;
        } else if (img) {
          img.sizes = "auto, " + sizes;
        }
        targetEl.appendChild(copy);
      }

      try {
        var dataEl = document.getElementById("guests-data");
        var guests = JSON.parse(dataEl.textContent);
        groupHero = JSON.parse(document.getElementById("group-hero").textContent);
        var preview = previewDate();
        var today = preview || todaySGT();
        var result = pickToday(guests, today);

        var appEl = document.getElementById("home-app");
        if (result.state === "vacancy") {
          var next = nextArrival(guests, today);
          appEl.innerHTML = heroVacancyHTML(result.lastGuest, next);
          appEl.hidden = false;
          insertPhoto("sofa", document.getElementById("vacancy-photo"), undefined, true, "high");
          if (next) insertPhoto(next.guest.id, document.getElementById("next-up-photo"), "64px");
          if (result.lastGuest) insertPhoto(result.lastGuest.id, document.getElementById("last-seen-photo"), "64px");
          // Tap the sofa to see what the last dogs left behind.
          var found = Math.floor(Math.random() * FOUND.length);
          document.getElementById("vacancy-photo").addEventListener("click", function () {
            heroNote("Found: " + FOUND[found++ % FOUND.length]);
          });
        } else {
          var hero = heroLiveHTML(result.live, today);
          appEl.innerHTML = hero.html + entryCardsHTML(result.live, today);
          var photosEl = document.getElementById("hero-photos");
          appEl.hidden = false;
          // Pat a dog and it hops and woofs. After that it's anyone's guess, never the same twice in a row.
          var dogBtns = result.live.map((d) => {
            var b = document.createElement("button");
            b.type = "button";
            b.ariaLabel = "Pat " + d.name;
            b.className = "block flex-1 min-w-0 h-full animate-drift cursor-pointer rounded-[24px] focus-visible:outline-2 focus-visible:outline-lime";
            var lines = ["Woof!"].concat(d.sounds, d.whenCalled || "Heard you. Busy.");
            var last;
            b.addEventListener("click", function () {
              var img = b.querySelector("img");
              if (img) replay(img, "dog-hop");
              var fresh = lines.filter((l) => l !== last);
              last = last ? fresh[Math.floor(Math.random() * fresh.length)] : "Woof!";
              heroNote((result.live.length > 1 ? d.name + ": " : "") + last);
            });
            photosEl.appendChild(b);
            return b;
          });
          result.live.forEach((d, i) => insertPhoto(d.id, dogBtns[i], undefined, true, i === 0 ? "high" : "auto"));
          result.live.forEach(markSeen);
        }
        if (preview) {
          var note = document.createElement("div");
          note.className =
            "mb-3.5 text-xs font-semibold tracking-[0.08em] uppercase border-[1.5px] border-dashed border-line rounded-full px-[13px] py-2 inline-block";
          note.textContent = "Preview · pretending it's " + fmtDay(preview);
          appEl.prepend(note);
        }
        appEl.hidden = false;

        var liveIds = result.live.map((d) => d.id);
        var past = pastGuests(guests, today)
          .filter((g) => liveIds.indexOf(g.id) === -1)
          .slice(0, 4);
        var previewEl = document.getElementById("past-preview-app");
        if (past.length > 0) {
          previewEl.innerHTML = pastPreviewHTML(past);
          past.forEach((g, i) => insertPhoto(g.id, document.getElementById("past-photo-" + i)));
          var pastSection = document.getElementById("past-guests-section");
          pastSection.classList.add("entrance", "entrance-delay-3");
          pastSection.hidden = false;
        }

        window.__tgpFitHeadlines();
        window.addEventListener("resize", window.__tgpFitHeadlines);
        window.addEventListener("resize", function () {
          document.querySelectorAll("#hero-photos img, #vacancy-photo img").forEach(function (img) {
            sizeHero(img, img.parentElement.parentElement);
          });
        });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(window.__tgpFitHeadlines);
        }
      } catch (err) {
        console.error("[towner-godpawrents] homepage render failed", err);
        var appEl = document.getElementById("home-app");
        appEl.innerHTML =
          '<div role="status" class="rounded-[24px] bg-cream card-keyline overflow-hidden py-[13px]">' +
          '<div class="diary-note"><p class="slip-caption">' +
          "Couldn't load today's diary just now. " +
          '<a href="/guests" class="font-semibold border-b-[1.5px] border-line hover:border-ink">Browse past guests</a>.' +
          "</p></div></div>";
        appEl.hidden = false;
      }
    })();
  </script>
</Layout>
