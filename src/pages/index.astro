---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Cutout from "../components/Cutout.astro";
import { getCollection } from "astro:content";
import {
  parseDiary,
  pastGuests,
  staysNewestFirst,
  warnOnOverlaps,
  dateStr,
  todaySGT,
} from "../lib/guests";

const entries = await getCollection("guests");

const guests = entries.map((e) => {
  const stays = staysNewestFirst(
    e.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
  );
  warnOnOverlaps(e.id, stays);
  return {
    id: e.id,
    name: e.data.name,
    breed: e.data.breed,
    tagline: e.data.tagline ?? "",
    badge: e.data.badge ?? "",
    bgColor: e.data.bgColor,
    showLive: e.data.showLive,
    photo: e.data.photo,
    stays,
    days: parseDiary(e.body ?? "", stays, e.id),
  };
});

// Sent to the client so it can work out who's "here today" in the
// Asia/Singapore timezone at load time — see the inline script below.
// Cut-outs aren't included here; they're pre-optimized at build time into the
// hidden #photo-bank and the client just re-parents the <img> nodes it needs,
// so no image processing has to happen in the browser. Diary prints are
// dropped too: they only ever show on the guest's page, and a text-only entry
// is all the teaser cards need. A per-day photoCount survives instead — the
// teaser never shows a print, but it does need to say how many are waiting.
const guestsForClient = guests.map(({ photo, days, ...rest }) => ({
  ...rest,
  days: days.map((d) => ({
    iso: d.iso,
    photoCount: d.entries.filter((e) => e.photo).length,
    entries: d.entries.map(({ photo: _photo, ...e }) => e),
  })),
}));
const guestsJson = JSON.stringify(guestsForClient).replace(/</g, "\\u003c");

const hasPastGuests = pastGuests(guests, todaySGT()).length > 0;
---

<Layout>
  <Nav />

  <div id="home-app" class="mt-8" hidden></div>

  <noscript>
    <p class="mt-8 text-base leading-relaxed">
      Enable JavaScript to see who's lepak-ing on the sofa today
      {hasPastGuests && (
        <>
          {" "}or <a href="/guests" class="border-b-[1.5px] border-ink">browse past guests</a>
        </>
      )}.
    </p>
  </noscript>

  <div class="mt-10 flex gap-4 items-start flex-wrap">
    <div class="w-[134px] h-[154px] rounded-[22px] overflow-hidden flex-none -rotate-[1.5deg] bg-cream">
      <img
        src="/images/alan-weiwen-portrait.png"
        alt="Alan and Weiwen smiling together"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="flex-1 min-w-[210px]">
      <div class="font-serif text-[36px] leading-none">Alan &amp; Weiwen</div>
      <p class="mt-[9px] text-base leading-relaxed text-pretty">
        Two humans in Towner with a sunny corner sofa and no dog of our own. Friends and
        neighbours drop theirs off, and we keep them fed, walked and thoroughly spoiled.
        This page is just so you can see who's lepak-ing here today.
      </p>
    </div>
  </div>

  <section id="past-guests-section" hidden>
    <div class="mt-11 border-t-[1.5px] border-ink pt-[18px] flex items-baseline justify-between gap-3">
      <div class="font-serif text-[32px] leading-none">Past guests</div>
      <a
        href="/guests"
        class="font-semibold text-[13px] border-[1.5px] border-ink px-[13px] py-1.5 rounded-full transition-colors duration-200 hover:bg-lime"
      >
        See all
      </a>
    </div>

    <div id="past-preview-app"></div>
  </section>

  <div class="mt-11 border-t-[1.5px] border-ink pt-[18px] text-base">
    Know a dog who needs a sofa? You know where to find us.
  </div>
  <div class="mt-2.5 text-xs tracking-[0.1em] uppercase text-label">
    Towner &middot; No dog of our own, just everyone else's
  </div>

  <!-- Hidden bank of pre-optimized cut-outs, one per guest. The client script
       re-parents (moves, doesn't clone) the node it needs into whichever
       card is showing right now. -->
  <div id="photo-bank" class="hidden">
    {guests.map((g) => (
      <div id={`photo-${g.id}`} class="h-full w-full">
        <Cutout photo={g.photo} name={g.name} />
      </div>
    ))}
  </div>

  <script type="application/json" id="guests-data" is:inline set:html={guestsJson} />

  <script is:inline>
    (function () {
      // ---- selection rules — MIRRORS src/lib/guests.ts, keep in sync ----
      function todaySGT() {
        return new Intl.DateTimeFormat("en-CA", {
          timeZone: "Asia/Singapore",
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        }).format(new Date());
      }

      // Preview helper: ?date=YYYY-MM-DD pretends it's another day, so we can
      // see a takeover before (or after) the dog actually turns up.
      function previewDate() {
        var m = /[?&]date=(\d{4}-\d{2}-\d{2})\b/.exec(location.search);
        return m ? m[1] : null;
      }

      function stayOn(g, todayISO) {
        return g.stays.filter((s) => s.checkIn <= todayISO && todayISO <= s.checkOut)[0];
      }
      // Stays arrive newest first, so the most recent one is simply the first.
      function latestStay(g) {
        return g.stays[0];
      }
      // What the guest did on a given day — the homepage only ever cares
      // about today, however long the stay runs.
      function dayOn(g, todayISO) {
        return g.days.filter((d) => d.iso === todayISO)[0] || { entries: [], photoCount: 0 };
      }

      function pickToday(guests, todayISO) {
        var live = guests
          .filter((g) => g.showLive && stayOn(g, todayISO))
          .sort((a, b) => {
            var x = stayOn(a, todayISO).checkIn,
              y = stayOn(b, todayISO).checkIn;
            return x < y ? -1 : x > y ? 1 : 0;
          });
        if (live.length > 0) {
          return { state: live.length === 1 ? "one" : "multi", live: live };
        }
        var past = guests
          .filter((g) => latestStay(g).checkOut < todayISO)
          .sort((a, b) => {
            var x = latestStay(a).checkOut,
              y = latestStay(b).checkOut;
            return x < y ? 1 : x > y ? -1 : 0;
          });
        return { state: "vacancy", live: [], lastGuest: past[0] };
      }

      var MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      function fmtDay(iso) {
        var parts = iso.split("-").map(Number);
        return parts[2] + " " + MONTHS[parts[1] - 1];
      }
      function stayLabel(s) {
        if (s.checkIn === s.checkOut) return fmtDay(s.checkIn);
        return fmtDay(s.checkIn) + "–" + fmtDay(s.checkOut);
      }

      // Lime is reserved for status badges (Here Today, tags) elsewhere on
      // the page, so this homepage teaser skips the lime skin lib/guests.ts
      // uses for the full diary — three lime patches on one view read as
      // clutter rather than a signal. Cream repeats instead.
      var SKINS = [
        { bg: "#F7F2E7", fg: "#1E2019", accent: "#4C6B3C" },
        { bg: "#2F4A3B", fg: "#F7F2E7", accent: "#D8F24E" },
        { bg: "#F7F2E7", fg: "#1E2019", accent: "#4C6B3C" },
        { bg: "#1E2019", fg: "#F3F1E9", accent: "#D8F24E" },
      ];
      function skin(i) {
        return SKINS[i % SKINS.length];
      }
      function tilt(i) {
        return i % 2 === 0 ? "-1deg" : "1deg";
      }
      var GROUP_WORDS = { 2: "Two", 3: "Three", 4: "Four", 5: "Five", 6: "Six" };
      function groupWord(n) {
        return GROUP_WORDS[n] || String(n);
      }

      function esc(s) {
        return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
          return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
        });
      }

      // ---- fit the giant headline to its container ----
      // `reserve` (px) keeps the text clear of the absolutely-positioned
      // "Here today" / "Sofa free" pill that overlaps the headline's top-right
      // corner — otherwise a very long name could fit the container width
      // exactly and still run visually under the pill.
      function fitText(el, reserve) {
        var parent = el.parentElement;
        if (!parent) return;
        var budget = parent.clientWidth - (reserve || 0);
        var cs = getComputedStyle(el);
        var max = parseFloat(cs.fontSize);
        el.style.fontSize = max + "px";
        if (el.scrollWidth <= budget + 1) return;
        var lo = 14,
          hi = max,
          best = lo;
        for (var i = 0; i < 18 && hi - lo > 0.5; i++) {
          var mid = (lo + hi) / 2;
          el.style.fontSize = mid + "px";
          if (el.scrollWidth <= budget + 1) {
            best = mid;
            lo = mid;
          } else {
            hi = mid;
          }
        }
        el.style.fontSize = best + "px";
      }
      window.__tgpFitHeadlines = function () {
        document.querySelectorAll(".fit-headline").forEach((el) => {
          var badge = document.getElementById("hero-badge");
          var reserve = badge && badge.offsetParent ? badge.offsetWidth + 12 : 0;
          fitText(el, reserve);
        });
      };

      // ---- build hero + today-entries markup for the live states ----
      function heroLiveHTML(live, today) {
        var pair = live.length > 1;
        var color = pair ? "#5F6E4F" : live[0].bgColor;
        var name = live.map((d) => d.name).join(" & ");
        var sub = pair
          ? groupWord(live.length) + " dogs, one sofa, no space for humans"
          : esc(live[0].tagline);
        var sizeClass = pair ? "text-[clamp(42px,12.5vw,82px)]" : "text-[clamp(62px,19vw,120px)]";
        var photoH = pair ? "250px" : "310px";

        var chips = [];
        if (!pair) {
          chips.push({ label: stayLabel(stayOn(live[0], today)), bg: "#F7F2E7" });
          if (live[0].badge) chips.push({ label: live[0].badge, bg: "#D8F24E" });
        } else {
          live.forEach((d) => chips.push({ label: d.name + " · " + d.breed, bg: "#F7F2E7" }));
          chips.push({ label: groupWord(live.length) + " dogs, one sofa", bg: "#D8F24E" });
        }

        var chipsHTML = chips
          .map(
            (c) =>
              '<span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink" style="background:' +
              c.bg +
              '">' +
              esc(c.label) +
              "</span>"
          )
          .join("");

        return {
          color: color,
          html:
            '<div class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:' +
            color +
            '">' +
            '<div id="hero-badge" class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full animate-wiggle">Here today</div>' +
            '<div class="w-full"><h1 class="fit-headline ' +
            sizeClass +
            ' max-w-full" id="hero-name">' +
            esc(name) +
            "</h1></div>" +
            '<div class="font-serif italic text-[22px] mt-2" style="color:#E9F7AE">' +
            sub +
            "</div>" +
            '<div class="mt-[14px] flex gap-2 flex-wrap">' +
            chipsHTML +
            "</div>" +
            '<div id="hero-photos" class="flex gap-1.5 items-end -mx-2 mt-[18px]" style="height:' +
            photoH +
            '"></div>' +
            "</div>",
          live: live,
        };
      }

      function heroVacancyHTML(lastGuest) {
        var html =
          '<div class="relative rounded-[32px] pt-[26px] px-6 pb-0 overflow-hidden text-cream animate-pop" style="background:#5F6E4F">' +
          '<div id="hero-badge" class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full animate-wiggle">Sofa free</div>' +
          '<div class="w-full"><h1 class="fit-headline text-[clamp(62px,19vw,120px)] max-w-full">Vacancy</h1></div>' +
          '<div class="font-serif italic text-[22px] mt-2" style="color:#E9F7AE">The sofa is free. The treats are ready.</div>' +
          '<div class="h-[265px] mx-[-8px] mt-[18px] animate-drift-slow rounded-2xl border-2 border-dashed border-cream/30 flex items-center justify-center text-cream/60 text-sm font-semibold">the sofa, unattended</div>' +
          "</div>";

        if (lastGuest) {
          html +=
            '<a href="/guests/' +
            esc(lastGuest.id) +
            '" class="mt-[18px] flex items-center gap-3.5 bg-cream border-[1.5px] border-ink rounded-[24px] p-[13px_15px] -rotate-1 transition-transform duration-250 hover:rotate-0 hover:scale-[1.02]">' +
            '<div id="last-seen-photo" class="w-16 h-16 rounded-[17px] overflow-hidden flex-none" style="background:' +
            lastGuest.bgColor +
            '"></div>' +
            '<div class="min-w-0">' +
            '<div class="font-semibold text-xs tracking-[0.08em] uppercase" style="color:#4C6B3C">Last seen here</div>' +
            '<div class="font-serif text-[27px] leading-tight">' +
            esc(lastGuest.name) +
            "</div>" +
            '<div class="text-sm">' +
            esc(lastGuest.breed) +
            " · checked out " +
            fmtDay(latestStay(lastGuest).checkOut) +
            "</div></div></a>";
        }
        return html;
      }

      // Everything here is scoped to TODAY, not to the whole stay: on day six
      // of a ten-day visit the page still answers "what happened today", and
      // every label below stays literally true.
      function entryCardsHTML(live, today) {
        var pair = live.length > 1;
        var cap = pair ? 1 : 3;
        var raw = [];
        live.forEach((d) =>
          // Photo-only entries are skipped here — the teaser is text, and a
          // wordless card would just be a timestamp floating on a colour.
          dayOn(d, today)
            .entries.filter((e) => e.text)
            .slice(0, cap)
            .forEach((e) => raw.push({ time: e.time, text: e.text, who: d.name, id: d.id }))
        );
        // The home teaser is one diary page rather than a grid of individual
        // notes. Space and a quiet divider separate moments, so the page does
        // not repeat the same card outline for every update.
        var entries = raw
          .map((e, i) => {
            var byline = pair ? " · " + esc(e.who) : "";
            return (
              '<a href="/guests/' +
              esc(e.id) +
              '" class="block py-[17px] transition-colors duration-200 hover:text-label' +
              (i ? " border-t border-ink/20" : "") +
              '">' +
              '<div class="font-semibold text-xs tracking-[0.08em] uppercase text-label">' +
              esc(e.time) +
              byline +
              "</div>" +
              '<p class="mt-2 text-base leading-relaxed text-pretty">' +
              esc(e.text) +
              "</p></a>"
            );
          })
          .join("");
        // Count against what the teaser actually shows, not the cap: a day
        // that so far is only photos shows no cards at all, and still has a
        // diary page worth linking to.
        var shown = {};
        raw.forEach((e) => (shown[e.id] = (shown[e.id] || 0) + 1));

        // What the link offers depends on what's actually left over: writing
        // the teaser didn't fit, photos it never shows, or both. Returns ""
        // when the teaser has already shown the whole day.
        function moreLabel(d) {
          var day = dayOn(d, today);
          var unread = day.entries.filter((e) => e.text).length > (shown[d.id] || 0);
          var whose = pair ? esc(d.name) + "&rsquo;s " : "the ";
          var n = day.photoCount || 0;
          if (unread) {
            return (
              (pair ? "Read " + esc(d.name) + "&rsquo;s full day" : "Read the full day") +
              (n ? " &middot; " + n + (n === 1 ? " photo" : " photos") : "")
            );
          }
          if (n === 1) return "See " + whose + "photo";
          if (n > 1) return "See " + whose + n + " photos";
          return "";
        }

        var more = live
          .map((d) => ({ id: d.id, label: moreLabel(d) }))
          .filter((m) => m.label);
        var moreHTML = more.length
          ? '<div class="' +
            (raw.length ? "mt-3.5" : "mt-5") +
            ' flex gap-4 flex-wrap">' +
            more
              .map(
                (m) =>
                  '<a href="/guests/' +
                  esc(m.id) +
                  '" class="text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">' +
                  m.label +
                  "</a>"
              )
              .join("") +
            "</div>"
          : "";
        var cardsHTML = raw.length
          ? '<section class="mt-5 overflow-hidden rounded-[24px] bg-cream px-5 py-1.5">' +
            '<div class="pt-[15px] font-serif text-[28px] leading-none">Today\'s notes</div>' +
            entries +
            "</section>"
          : "";
        return cardsHTML + moreHTML;
      }

      function pastPreviewHTML(cards) {
        var html = cards
          .map((g, i) => {
            return (
              '<a href="/guests/' +
              esc(g.id) +
              '" class="block rounded-[22px] overflow-hidden transition-transform duration-250 hover:rotate-3 hover:scale-[1.03]" style="background:' +
              g.bgColor +
              '">' +
              '<div class="h-[114px] p-[9px_9px_0]"><div id="past-photo-' +
              i +
              '" class="h-full w-full"></div></div>' +
              '<div class="p-[9px_13px_13px] bg-cream">' +
              '<div class="font-serif text-[22px] leading-none">' +
              esc(g.name) +
              "</div>" +
              '<div class="text-[13px] text-muted">' +
              stayLabel(latestStay(g)) +
              "</div></div></a>"
            );
          })
          .join("");
        return '<div class="mt-3.5 grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(140px,1fr))">' + html + "</div>";
      }

      function movePhoto(id, targetEl) {
        var node = document.getElementById("photo-" + id);
        if (node && targetEl) targetEl.appendChild(node);
      }

      try {
        var dataEl = document.getElementById("guests-data");
        var guests = JSON.parse(dataEl.textContent);
        var preview = previewDate();
        var today = preview || todaySGT();
        var result = pickToday(guests, today);

        var appEl = document.getElementById("home-app");
        if (result.state === "vacancy") {
          appEl.innerHTML = heroVacancyHTML(result.lastGuest);
          if (result.lastGuest) movePhoto(result.lastGuest.id, document.getElementById("last-seen-photo"));
        } else {
          var hero = heroLiveHTML(result.live, today);
          appEl.innerHTML = hero.html + entryCardsHTML(result.live, today);
          var photosEl = document.getElementById("hero-photos");
          result.live.forEach((d) => {
            var a = document.createElement("a");
            a.href = "/guests/" + d.id;
            a.className = "block flex-1 min-w-0 h-full animate-drift transition-[filter] duration-200";
            photosEl.appendChild(a);
            movePhoto(d.id, a);
          });
        }
        if (preview) {
          var note = document.createElement("div");
          note.className =
            "mb-3.5 text-xs font-semibold tracking-[0.08em] uppercase border-[1.5px] border-dashed border-ink rounded-full px-[13px] py-2 inline-block";
          note.textContent = "Preview · pretending it's " + fmtDay(preview);
          appEl.prepend(note);
        }
        appEl.hidden = false;

        var liveIds = result.live.map((d) => d.id);
        var past = guests
          .filter((g) => latestStay(g).checkOut < today && liveIds.indexOf(g.id) === -1)
          .sort((a, b) => {
            var x = latestStay(a).checkOut,
              y = latestStay(b).checkOut;
            return x < y ? 1 : x > y ? -1 : 0;
          })
          .slice(0, 4);
        var previewEl = document.getElementById("past-preview-app");
        if (past.length > 0) {
          previewEl.innerHTML = pastPreviewHTML(past);
          past.forEach((g, i) => movePhoto(g.id, document.getElementById("past-photo-" + i)));
          document.getElementById("past-guests-section").hidden = false;
        }

        window.__tgpFitHeadlines();
        window.addEventListener("resize", window.__tgpFitHeadlines);
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(window.__tgpFitHeadlines);
        }
      } catch (err) {
        console.error("[towner-godpawrents] homepage render failed", err);
        document.getElementById("home-app").hidden = false;
      }
    })();
  </script>
</Layout>
