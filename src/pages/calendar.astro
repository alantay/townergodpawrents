---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Cutout from "../components/Cutout.astro";
import { dateStr, diarySkin, fmtDay, stayLabel, todaySGT } from "../lib/guests";
import { calendarMonths } from "../lib/calendar";

const entries = await getCollection("guests");

// Every stay of every dog, flattened, carrying what a bar or polaroid needs.
const stays = entries.flatMap((e) =>
  e.data.stays.map((s) => ({
    guestId: e.id,
    name: e.data.name,
    photo: e.data.photo,
    bgColor: e.data.bgColor,
    tint: diarySkin(e.data.bgColor, 0).bg,
    checkIn: dateStr(s.checkIn),
    checkOut: dateStr(s.checkOut),
  })),
);

// Built statically, so this is only the build day. The script below re-reads
// today in Singapore time to fold away old months and circle the date.
const months = calendarMonths(stays, todaySGT());
const WEEKDAYS = ["M", "T", "W", "T", "F", "S", "S"];
---

<Layout title="Calendar · The Towner Godpawrents">
  <Nav />

  <a href="/" class="entrance entrance-delay-1 mt-8 inline-block text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">
    ← Back to today
  </a>

  <header class="entrance entrance-delay-1 mt-4">
    <h1 class="font-serif text-[clamp(40px,11vw,72px)] leading-[0.9] tracking-[-0.02em]">
      Who's on the sofa when
    </h1>
    <p class="mt-3 text-base leading-relaxed text-pretty max-w-[52ch]">
      So the neighbours know why we keep turning down dinner.
    </p>
  </header>

  <div class="mt-10 flex flex-col gap-14">
    {months.map((month, mi) => {
      const pups = new Set(month.stays.map((s) => s.guestId)).size;
      return (
        <section
          class="cal-month reveal-card"
          data-month={month.key}
          style={`--sheet-tilt:${mi % 2 === 0 ? "-0.6deg" : "0.6deg"}`}
          aria-labelledby={`cal-${month.key}`}
        >
          <div class="cal-sheet">
            <div class:list={["cal-sheet-paper", `cal-sheet-paper--tear-${mi % 3}`]} aria-hidden="true" />
            <span class="cal-tape" aria-hidden="true" />

            <div class="cal-sheet-body">
              <div class="flex items-baseline justify-between gap-3 flex-wrap">
                <h2 id={`cal-${month.key}`} class="font-script text-[40px] leading-none font-semibold">
                  {month.name} <span class="text-label text-[28px]">{month.year}</span>
                </h2>
                <p class="font-script text-[22px] leading-none text-muted">
                  {pups === 0
                    ? "sofa's free"
                    : <>{pups} {pups === 1 ? "pup" : "pups"} this month{pups >= 3 && <span class="text-[#b3261e]"> → busy sofa!</span>}</>}
                </p>
              </div>

              <div class="cal-weekdays mt-4" aria-hidden="true">
                {WEEKDAYS.map((d) => <span>{d}</span>)}
              </div>

              {month.weeks.map((week) => (
                <div class="cal-week" style={`grid-template-rows:auto repeat(${week.lanes},26px)`}>
                  {week.days.map((d, col) => (
                    <span
                      class:list={["cal-day", { "cal-day--out": !d.inMonth }]}
                      style={`grid-column:${col + 1}`}
                      data-date={d.iso}
                    >
                      {d.day}
                    </span>
                  ))}
                  {week.segments.map((seg) => {
                    const s = seg.stay;
                    const endsHere = s.checkOut <= week.days[6].iso;
                    return (
                      <a
                        href={`/guests/${s.guestId}`}
                        class:list={["cal-bar", { "cal-bar--continued": seg.continued, "cal-bar--carries": !endsHere, "cal-bar--short": seg.span === 1 }]}
                        style={`grid-row:${seg.lane + 2};grid-column:${seg.startCol + 1} / span ${seg.span};--bar-tint:${s.tint};--bar-colour:${s.bgColor}`}
                        data-check-in={s.checkIn}
                        aria-label={seg.continued ? undefined : `${s.name}, ${stayLabel(s)}`}
                        aria-hidden={seg.continued ? "true" : undefined}
                        tabindex={seg.continued ? -1 : undefined}
                      >
                        {!seg.continued && (
                          <span class="cal-bar-avatar" style={`background:${s.bgColor}`}>
                            {s.photo && <Image src={s.photo} alt="" width={48} class="h-full w-full object-contain" />}
                          </span>
                        )}
                        <span class="cal-bar-name">
                          {seg.continued ? `…${s.name}` : s.name}
                          {!seg.continued && <span class="cal-bar-booked"> (booked!)</span>}
                        </span>
                      </a>
                    );
                  })}
                </div>
              ))}

              {month.stays.length > 0 && (
                <div class="mt-7 flex flex-wrap gap-4">
                  {month.stays.map((s, pi) => (
                    <a
                      href={`/guests/${s.guestId}`}
                      class="cal-polaroid"
                      style={`--polaroid-tilt:${pi % 2 === 0 ? "-2deg" : "1.5deg"}`}
                    >
                      <span class="cal-tape cal-tape--small" aria-hidden="true" />
                      <span class="block h-[92px] w-[92px] overflow-hidden rounded-[3px] p-1.5" style={`background:${s.bgColor}`}>
                        <Cutout photo={s.photo} name={s.name} />
                      </span>
                      <span class="mt-1.5 block font-script text-[20px] leading-none">{s.name}</span>
                      <span class="mt-0.5 block text-[11px] text-label tabular-nums">
                        {s.checkIn === s.checkOut ? fmtDay(s.checkIn) : stayLabel(s)}
                      </span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <footer class="entrance entrance-delay-3 mt-12 border-t-[1.5px] border-line pt-[18px] text-xs tracking-[0.1em] uppercase text-label">
    Towner &middot; No dog of our own, just everyone else's
  </footer>
</Layout>

<script is:inline>
  // Mirrors todaySGT() in src/lib/guests.ts — the page is built once, but
  // "today" moves. Without this script every month simply shows.
  (function () {
    var today = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Singapore",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).format(new Date());
    var thisMonth = today.slice(0, 7);
    document.querySelectorAll(".cal-month").forEach(function (m) {
      if (m.dataset.month < thisMonth) m.hidden = true;
    });
    document.querySelectorAll('.cal-day[data-date="' + today + '"]').forEach(function (d) {
      d.classList.add("is-today");
      d.setAttribute("aria-current", "date");
    });
    document.querySelectorAll(".cal-bar").forEach(function (b) {
      b.classList.toggle("is-upcoming", b.dataset.checkIn > today);
    });
  })();
</script>

<style>
  /* One month is a planner sheet, torn out and taped to the page. The tear
     is a filter on the paper layer only, like the diary slips; the grid lives
     on the weeks so the filter can't smudge it. */
  .cal-month[hidden] { display: none; }

  .cal-sheet {
    position: relative;
    padding: 26px 20px 24px;
    transform: rotate(var(--sheet-tilt));
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cal-sheet:hover { transform: rotate(0deg); }

  .cal-sheet-paper {
    position: absolute;
    inset: 0;
    background: var(--color-cream);
    background-clip: padding-box;
    border: 5px solid #fdfaf1;
    filter: url("#torn-slip-0") drop-shadow(0 6px 10px rgb(30 32 25 / 0.18));
  }
  .cal-sheet-paper--tear-1 { filter: url("#torn-slip-1") drop-shadow(0 6px 10px rgb(30 32 25 / 0.18)); }
  .cal-sheet-paper--tear-2 { filter: url("#torn-slip-2") drop-shadow(0 6px 10px rgb(30 32 25 / 0.18)); }

  @supports not (filter: url("#torn-slip-0")) {
    .cal-sheet-paper { filter: none; border: 1.5px solid var(--color-card-line); }
  }

  .cal-sheet-body { position: relative; isolation: isolate; }

  .cal-tape {
    position: absolute;
    top: -10px;
    left: 50%;
    width: 84px;
    height: 22px;
    margin-left: -42px;
    background: rgb(216 242 78 / 0.85);
    clip-path: polygon(0 10%, 6% 0, 100% 8%, 96% 50%, 100% 92%, 4% 100%, 0 90%, 3% 50%);
    transform: rotate(-2deg);
    z-index: 1;
  }
  .cal-tape--small {
    top: -8px;
    width: 46px;
    height: 16px;
    margin-left: -23px;
    transform: rotate(3deg);
  }

  .cal-weekdays,
  .cal-week {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    column-gap: 2px;
  }
  .cal-weekdays {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-label);
    text-align: center;
  }
  .cal-week {
    position: relative;
    row-gap: 3px;
    padding: 6px 0 8px;
  }
  /* The grid is ruled by hand in pencil: a line in each gap between days and
     one under the week, wobbled on their own layer so the dates stay crisp. */
  .cal-week::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(rgb(140 126 98 / 0.45), rgb(140 126 98 / 0.45)) left bottom / 100% 1.25px no-repeat,
      linear-gradient(to right, transparent calc(100% - 1.25px), rgb(140 126 98 / 0.3) 0)
        0 0 / calc((100% + 2px) / 7) 100% repeat-x;
    filter: url("#pencil-rule");
  }
  .cal-week:last-child::before { background-size: 0 0, calc((100% + 2px) / 7) 100%; }

  .cal-day {
    grid-row: 1;
    justify-self: center;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .cal-day--out { color: rgb(30 32 25 / 0.3); }

  /* A red biro ring, slightly off-round, around today. */
  .cal-day.is-today {
    border: 2px solid #b3261e;
    border-radius: 55% 45% 50% 50% / 50% 55% 45% 50%;
    transform: rotate(-8deg);
  }

  /* Each stay is a strip of washi tape in the dog's own colour: diagonal
     stripes, torn ends. The tape is a pseudo-element so its clip-path can't
     cut off the link's focus ring. A strip that runs on into the next week
     keeps a straight edge there, like tape wrapping round the page. */
  .cal-bar {
    --tape: color-mix(in srgb, var(--bar-colour) 55%, var(--color-cream));
    --tear-l: 5px;
    --tear-r: 5px;
    position: relative;
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
    padding: 0 10px 0 7px;
    color: var(--color-ink);
    transform: rotate(-0.4deg);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cal-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(
      -45deg,
      var(--tape) 0 7px,
      color-mix(in srgb, var(--tape) 65%, var(--color-cream)) 7px 14px
    );
    opacity: 0.92;
    clip-path: polygon(
      var(--tear-l) 0, 100% 0,
      calc(100% - var(--tear-r)) 25%, 100% 50%, calc(100% - var(--tear-r)) 75%, 100% 100%,
      0 100%, var(--tear-l) 75%, 0 50%, var(--tear-l) 25%
    );
    box-shadow: 0 1px 2px rgb(30 32 25 / 0.12);
  }
  .cal-bar:hover { transform: rotate(0deg) translateY(-1px); }
  .cal-bar:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  .cal-bar--continued { --tear-l: 0px; padding-left: 8px; }
  .cal-bar--carries { --tear-r: 0px; }

  /* Booked but not arrived: a dashed box in the dog's colour, not taped down
     yet. The box stays open where the stay runs on into another week. */
  .cal-bar.is-upcoming::before {
    background: color-mix(in srgb, var(--bar-colour) 8%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--bar-colour) 85%, var(--color-ink));
    clip-path: none;
    box-shadow: none;
    opacity: 1;
  }
  .cal-bar--continued.is-upcoming::before { border-left: 0; }
  .cal-bar--carries.is-upcoming::before { border-right: 0; }
  .cal-bar-booked { display: none; }
  .cal-bar.is-upcoming .cal-bar-booked { display: inline; }

  /* A one-day strip only has room for the photo; the link's label still
     names the dog. */
  .cal-bar--short { justify-content: center; padding: 0 6px; }
  .cal-bar--short .cal-bar-name { display: none; }

  .cal-bar-avatar {
    flex: none;
    width: 20px;
    height: 20px;
    overflow: hidden;
    border-radius: 999px;
    box-shadow: 0 0 0 2px #fdfaf1;
  }
  .cal-bar-name {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-script);
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
  }

  .cal-polaroid {
    position: relative;
    display: block;
    width: 108px;
    padding: 8px 8px 10px;
    background: #fdfaf1;
    box-shadow: 0 4px 9px rgb(30 32 25 / 0.16);
    transform: rotate(var(--polaroid-tilt));
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cal-polaroid:hover { transform: rotate(0deg) translateY(-2px); }
  .cal-polaroid:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .cal-sheet, .cal-polaroid, .cal-bar { transition: none; }
  }
</style>
