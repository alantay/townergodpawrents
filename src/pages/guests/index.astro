---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Cutout from "../../components/Cutout.astro";
import { stayLabel, staysNewestFirst, latestStay, dateStr, todaySGT } from "../../lib/guests";

const entries = await getCollection("guests");
const today = todaySGT();

// Everyone who's ever stayed, most recently departed first. A dog appears
// once however many times they've been — the date is their last visit.
const guests = entries
  .map((e) => ({
    id: e.id,
    name: e.data.name,
    breed: e.data.breed,
    bgColor: e.data.bgColor,
    photo: e.data.photo,
    stays: staysNewestFirst(
      e.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
    ),
  }))
  .filter((g) => latestStay(g).checkOut < today)
  .sort((a, b) => latestStay(b).checkOut.localeCompare(latestStay(a).checkOut));
const returningGuests = guests.filter((g) => g.stays.length > 1).length;
---

<Layout title="Past guests · The Towner Godpawrents">
  <Nav />

  <a href="/" class="entrance entrance-delay-1 mt-8 inline-block text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">
    ← Back to today
  </a>

  <header class="entrance entrance-delay-1 mt-4">
    <h1 class="font-serif text-[clamp(40px,11vw,72px)] leading-[0.9] tracking-[-0.02em]">
      Everyone who's stayed
    </h1>
    <p class="mt-3 text-base leading-relaxed text-pretty max-w-[52ch]">
      Every dog who's had a turn on the sofa, newest first. Some of them keep coming back.
    </p>
    {guests.length > 0 && (
      <p class="archive-count mt-5 text-[12px] font-semibold tracking-[0.1em] uppercase text-label">
        {guests.length} {guests.length === 1 ? "guest" : "guests"}
        {returningGuests > 0 && <> &middot; {returningGuests} sofa regular{returningGuests === 1 ? "" : "s"}</>}
      </p>
    )}
  </header>

  {guests.length === 0 ? (
    <p class="mt-8 text-sm text-label">No one's stayed yet. The sofa is very patient.</p>
  ) : (
    <div
      class="mt-8 grid gap-3.5"
      style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))"
    >
      {guests.map((g, index) => (
        <div
          class:list={[
            "reveal-card",
            { "sm:col-span-2": index === 0 && guests.length > 2 },
          ]}
        >
          <a
            href={`/guests/${g.id}`}
            class="dog-card block rounded-[22px] overflow-hidden transition-all duration-250 hover:-translate-y-0.5 active:scale-[0.99]"
            style={`background:${g.bgColor}`}
          >
            <div class:list={["p-[9px_9px_0]", { "h-[178px]": index === 0 && guests.length > 2, "h-[132px]": !(index === 0 && guests.length > 2) }]}>
              <Cutout photo={g.photo} name={g.name} />
            </div>
            <div class="p-[11px_13px_14px] bg-cream">
              <div class="font-serif text-[22px] leading-none">{g.name}</div>
              <div class="mt-1 flex flex-col gap-0.5 text-[13px] text-muted">
                <span>{g.breed}</span>
                <span class="archive-date">{stayLabel(latestStay(g))}</span>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  )}

  <footer class="entrance entrance-delay-3 mt-12 border-t-[1.5px] border-line pt-[18px] text-xs tracking-[0.1em] uppercase text-label">
    Towner &middot; No dog of our own, just everyone else's
  </footer>
</Layout>
