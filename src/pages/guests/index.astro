---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Cutout from "../../components/Cutout.astro";
import { stayLabel, staysNewestFirst, lastEndedStay, isLiveOn, stayOn, dateStr, todaySGT } from "../../lib/guests";

const entries = await getCollection("guests");
const today = todaySGT();

// Everyone who's arrived at least once. Whoever's here right now goes on
// top, then the rest by when they last went home. A dog appears once however
// many times they've been. The script at the bottom redoes all this in the
// visitor's own today, since the page is only built now and then.
const all = entries.map((e) => {
  const stays = staysNewestFirst(
    e.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
  );
  return {
    id: e.id,
    name: e.data.name,
    breed: e.data.breed,
    bgColor: e.data.bgColor,
    photo: e.data.photo,
    showLive: e.data.showLive,
    stays,
  };
});
function arrived(g: (typeof all)[number], iso: string) {
  return g.stays.some((s) => s.checkIn <= iso);
}
function sortKey(g: (typeof all)[number], iso: string) {
  return isLiveOn(g, iso) ? "9999" : (lastEndedStay(g, iso)?.checkOut ?? "");
}
const guests = all
  .filter((g) => arrived(g, today))
  .sort((a, b) => sortKey(b, today).localeCompare(sortKey(a, today)));
const returningGuests = guests.filter((g) => g.stays.filter((s) => s.checkIn <= today).length > 1).length;
const wide = (i: number) => i === 0 && guests.length > 2;
// The date under each name: the stay they're on, else the last one that ended.
const dateFor = (g: (typeof all)[number]) =>
  stayLabel((isLiveOn(g, today) && stayOn(g, today)) || lastEndedStay(g, today)!);

// Same keyline rule as the homepage cards: darker line on dark coats.
function luma(hex: string) {
  const h = hex.replace("#", "");
  return 0.2126 * parseInt(h.slice(0, 2), 16) + 0.7152 * parseInt(h.slice(2, 4), 16) + 0.0722 * parseInt(h.slice(4, 6), 16);
}
---

<Layout
  title="Guests · The Towner Godpawrents"
  description="Every dog who's stayed with us so far, and the diary of each visit."
>
  <Nav />

  <a href="/" class="entrance entrance-delay-1 mt-8 inline-block text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">
    ← Back to today
  </a>

  <header class="entrance entrance-delay-1 mt-4">
    <h1 class="font-serif text-[clamp(40px,11vw,72px)] leading-[0.9] tracking-[-0.02em]">
      Everyone who's stayed
    </h1>
    <p class="mt-3 text-base leading-relaxed text-pretty max-w-[52ch]">
      Newest first.<span id="returning-note" hidden={returningGuests === 0}> Some of them keep coming back.</span>
    </p>
    {guests.length > 0 && (
      <p id="archive-count" class="archive-count mt-5 text-[12px] font-semibold tracking-[0.1em] uppercase text-label">
        {guests.length} {guests.length === 1 ? "guest" : "guests"}
        {returningGuests > 0 && <> &middot; {returningGuests} sofa regular{returningGuests === 1 ? "" : "s"}</>}
      </p>
    )}
  </header>

  {guests.length === 0 ? (
    <p class="mt-8 text-sm text-label">No one's stayed yet. The sofa is very patient.</p>
  ) : (
    <div
      id="guest-grid"
      class="mt-8 grid gap-3.5"
      style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr))"
    >
      {guests.map((g, index) => (
        <div
          class:list={["reveal-card guest-cell", { "sm:col-span-2": wide(index) }]}
          data-live={g.showLive ? "1" : undefined}
          data-stays={JSON.stringify(g.stays.map((s) => ({ in: s.checkIn, out: s.checkOut, label: stayLabel(s) })))}
        >
          <a
            href={`/guests/${g.id}`}
            class:list={[
              "dog-card relative block rounded-[24px] overflow-hidden transition-all duration-250 hover:-translate-y-0.5 active:scale-[0.99] card-keyline",
              index % 2 ? "rotate-1" : "-rotate-1",
              { "card-keyline--dark": luma(g.bgColor) < 110 },
            ]}
            style={`background:${g.bgColor}`}
          >
            <span
              class="here-pill absolute top-2.5 right-2.5 z-10 bg-lime text-ink font-semibold text-[11px] tracking-[0.06em] uppercase px-[11px] py-1.5 rounded-full"
              hidden={!isLiveOn(g, today)}
            >
              Here today
            </span>
            <div class:list={["cell-photo p-[9px_9px_0]", wide(index) ? "h-[178px]" : "h-[132px]"]}>
              <Cutout photo={g.photo} name={g.name} height={wide(index) ? 169 : 123} loading={index < 2 ? "eager" : "lazy"} />
            </div>
            <div class="p-[11px_13px_14px] bg-cream">
              <div class="font-serif text-[22px] leading-none">{g.name}</div>
              <div class="mt-1 flex flex-col gap-0.5 text-[13px] text-muted">
                <span>{g.breed}</span>
                <span class="archive-date">{dateFor(g)}</span>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  )}

  <script is:inline>
    // Redo the build-time list in the visitor's today (Singapore time): drop
    // anyone not arrived yet, pin whoever's here to the top, and redate.
    // MIRRORS the frontmatter above.
    (function () {
      var grid = document.getElementById("guest-grid");
      if (!grid) return;
      var today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Singapore", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
      var cells = Array.prototype.slice.call(grid.querySelectorAll(".guest-cell"));
      var shown = [];
      var returning = 0;
      cells.forEach(function (cell) {
        var stays = JSON.parse(cell.dataset.stays);
        var started = stays.filter(function (s) { return s.in <= today; });
        var now = cell.dataset.live ? stays.filter(function (s) { return s.in <= today && today <= s.out; })[0] : null;
        var ended = stays.filter(function (s) { return s.out < today; })[0];
        cell.hidden = started.length === 0;
        if (cell.hidden) return;
        if (started.length > 1) returning++;
        cell.querySelector(".here-pill").hidden = !now;
        cell.querySelector(".archive-date").textContent = (now || ended).label;
        shown.push({ cell: cell, key: now ? "9999" : ended ? ended.out : "" });
      });
      shown.sort(function (a, b) { return a.key < b.key ? 1 : a.key > b.key ? -1 : 0; });
      shown.forEach(function (s, i) {
        var wide = i === 0 && shown.length > 2;
        var card = s.cell.querySelector(".dog-card");
        var photo = s.cell.querySelector(".cell-photo");
        s.cell.classList.toggle("sm:col-span-2", wide);
        card.classList.toggle("rotate-1", i % 2 === 1);
        card.classList.toggle("-rotate-1", i % 2 === 0);
        photo.classList.toggle("h-[178px]", wide);
        photo.classList.toggle("h-[132px]", !wide);
        grid.appendChild(s.cell);
      });
      var count = document.getElementById("archive-count");
      if (count) {
        count.textContent =
          shown.length + (shown.length === 1 ? " guest" : " guests") +
          (returning > 0 ? " \u00b7 " + returning + " sofa regular" + (returning === 1 ? "" : "s") : "");
      }
      var note = document.getElementById("returning-note");
      if (note) note.hidden = returning === 0;
    })();
  </script>

  <Footer />
</Layout>
