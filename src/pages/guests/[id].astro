---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Cutout from "../../components/Cutout.astro";
import {
  parseDiary,
  stayLabel,
  staysNewestFirst,
  stayOn,
  latestStay,
  warnOnOverlaps,
  dateStr,
  diarySkin,
  tilt,
  printTilt,
  noteTilt,
  fitsPrintMat,
  printWidth,
  todaySGT,
  type DiaryMedia,
} from "../../lib/guests";

// Diary media is referenced from inside the markdown body, which parseDiary
// reads as raw text — so it never passes through Astro's markdown image
// pipeline. Globbing the folder here gets photos optimized anyway; videos
// aren't optimized by Astro, so they're just resolved to a built URL.
const diaryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../content/guests/**/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);
const diaryVideos = import.meta.glob<string>("../../content/guests/**/*.mp4", {
  eager: true,
  query: "?url",
  import: "default",
});
// ffprobe isn't available at Vercel build time, so prep-video.sh captures the
// encoded dimensions (portrait clips included) as a sidecar JSON file.
const diaryVideoDims = import.meta.glob<{ width: number; height: number }>(
  "../../content/guests/**/*.mp4.json",
  { eager: true, import: "default" },
);

type ResolvedMedia =
  | { kind: "photo"; img: ImageMetadata; alt: string }
  | { kind: "video"; url: string; poster: string; alt: string; width: number; height: number };

function resolveDiaryMedia(media: DiaryMedia, guestId: string, when: string): ResolvedMedia {
  const file = media.src.split("/").pop()!;
  if (media.kind === "video") {
    const key = Object.keys(diaryVideos).find((k) => k.endsWith(`/${file}`));
    if (!key) {
      throw new Error(
        `[guests] ${guestId}, ${when}: no video "${file}" in src/content/guests/ (written as "${media.src}")`,
      );
    }
    const dimsKey = Object.keys(diaryVideoDims).find((k) => k.endsWith(`/${file}.json`));
    if (!dimsKey) {
      throw new Error(
        `[guests] ${guestId}, ${when}: no "${file}.json" dimensions sidecar — re-run scripts/prep-video.sh`,
      );
    }
    const posterKey = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}.jpg`));
    if (!posterKey) {
      throw new Error(
        `[guests] ${guestId}, ${when}: no "${file}.jpg" poster sidecar — re-run scripts/prep-video.sh`,
      );
    }
    const { width, height } = diaryVideoDims[dimsKey];
    return {
      kind: "video",
      url: diaryVideos[key],
      poster: diaryImages[posterKey].default.src,
      alt: media.alt,
      width,
      height,
    };
  }
  const key = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[guests] ${guestId}, ${when}: no image "${file}" in src/content/guests/ (written as "${media.src}")`,
    );
  }
  return { kind: "photo", img: diaryImages[key].default, alt: media.alt };
}

export async function getStaticPaths() {
  const entries = await getCollection("guests");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, breed, tagline, badge, bgColor, showLive, photo } = entry.data;

const stays = staysNewestFirst(
  entry.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
);
warnOnOverlaps(entry.id, stays);

const today = todaySGT();
const here = stayOn({ stays }, today);
const isLive = showLive && here !== undefined;
// The chip shows the visit that's happening, or the last one that did.
const shownStay = here ?? latestStay({ stays });

const days = parseDiary(entry.body ?? "", stays, entry.id);
const entryCount = days.reduce((total, day) => total + day.entries.length, 0);

// The palette rotates through the whole diary rather than restarting each
// day, so a long stay doesn't come out striped.
let skinIndex = 0;
---

<Layout
  title={`${name} · The Towner Godpawrents`}
  description={tagline ? `${name} the ${breed}: ${tagline}.` : `${name} the ${breed}, and the diary of their stay in Towner.`}
  ogImage={`/og/${entry.id}.jpg`}
>
  <Nav />

  <a href="/" class="entrance entrance-delay-1 mt-8 inline-block text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">
    ← Back to today
  </a>

  <header
    class="guest-hero entrance-hero entrance-delay-1 mt-4 relative rounded-[32px] pt-[26px] px-6 pb-[18px] overflow-hidden text-cream"
    style={`background:${bgColor}`}
  >
    {showLive && (
      <div
        id="here-today"
        class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full"
        hidden={!isLive}
      >
        Here today
      </div>
    )}

    <h1 class="font-serif text-[clamp(48px,13vw,88px)] leading-[0.88] tracking-[-0.02em] max-w-full">
      {name}
    </h1>

    {tagline && (
      <div class="font-serif italic text-[20px] mt-2" style="color:#E9F7AE">
        {tagline}
      </div>
    )}

    <div class="mt-[14px] flex gap-2 flex-wrap">
      <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-cream">{breed}</span>
      <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-cream">
        {stayLabel(shownStay)}
      </span>
      {showLive && (
        <span id="stay-day" class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-cream" hidden></span>
      )}
      {badge && (
        <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-lime">{badge}</span>
      )}
    </div>

    <div class="guest-cutout -mx-2 mt-[18px]" style="height:280px">
      <Cutout photo={photo} name={name} />
    </div>
  </header>

  <div class="entrance entrance-delay-2 mt-12 border-t-[1.5px] border-line pt-[18px] flex items-end justify-between gap-4">
    <div>
      <div class="font-serif text-[32px] leading-none">The full diary</div>
      {entryCount > 0 && <p class="mt-1.5 text-sm text-label">{entryCount} little moment{entryCount === 1 ? "" : "s"}, kept for the record.</p>}
    </div>
    <div class="diary-stay hidden sm:block text-right text-[11px] font-semibold tracking-[0.08em] uppercase text-label">
      Latest stay<br />{stayLabel(shownStay)}
    </div>
  </div>

  {days.length === 0 ? (
    <p class="mt-3.5 text-sm text-label">No diary entries yet. Check back once the visit gets going.</p>
  ) : (
    <>
    {days.length > 1 && (
      <nav class="day-strip" aria-label="Jump to a day">
        {days.map((day) => (
          <a href={`#day-${day.iso}`} class="day-chip" data-day={day.iso}>{day.label}</a>
        ))}
      </nav>
    )}

    <div class="diary-timeline">
      {days.map((day) => (
        <section id={`day-${day.iso}`} class="diary-day mt-8 first:mt-5">
          <div class="diary-day-heading flex items-baseline gap-3">
            <div class="diary-date font-serif text-[24px] leading-none flex-none">{day.label}</div>
            <div class="h-px flex-1 bg-ink/20"></div>
          </div>

          <div class="mt-4 grid gap-5">
            {day.entries.map((e) => {
              const i = skinIndex++;
              const sk = diarySkin(bgColor, i);
              const darkSkin = i % 4 > 1;
              const prints = e.media.map((m) => resolveDiaryMedia(m, entry.id, `${day.label} ${e.time}`));
              const video = prints.find((p) => p.kind === "video");
              const singlePrint = !video && prints.length === 1;
              const manyPrints = !video && prints.length > 1;
              // A caption goes on the mat only when one print can hold it in a
              // few words. Anything longer, or spread over several prints, gets
              // its own ruled slip underneath — never both.
              const matCaption = singlePrint && !!e.text && fitsPrintMat(e.text);
              const noteCaption = prints.length > 0 && !!e.text && !matCaption;
              // A slip under one photo or video can extend beyond a narrow
              // portrait print, so longer captions have room to breathe.
              // Under a grid it spans the card.
              const noteWidth =
                video
                  ? Math.min(printWidth(video.width, video.height) + 120, 500)
                  : singlePrint && prints[0].kind === "photo"
                    ? Math.min(printWidth(prints[0].img.width, prints[0].img.height) + 120, 500)
                    : null;
              return (
                <div class="reveal-card">
                  <article
                    class:list={{ "diary-entry": true, "card-keyline": true, "card-keyline--dark": darkSkin, "rounded-[24px]": true, "p-[18px_19px_20px]": true }}
                    style={`background:${sk.bg};color:${sk.fg};--entry-tilt:${tilt(i)}`}
                  >
                  <div class="flex items-center gap-2">
                    <span class="diary-dot" style={`background:${sk.accent}`}></span>
                    <div class="font-semibold text-xs tracking-[0.08em] uppercase" style={`color:${sk.accent}`}>
                      {e.time}
                    </div>
                    <span class="new-tag" data-entry-key={`${day.iso} ${e.time}`} hidden>New</span>
                  </div>

                  {video && (
                    <div
                      class="diary-print mt-[15px] mx-auto bg-cream card-keyline rounded-[16px] p-[7px]"
                      style={`width:min(100%,${printWidth(video.width, video.height)}px)`}
                    >
                      <video
                        src={video.url}
                        poster={video.poster}
                        controls
                        preload="metadata"
                        aria-label={video.alt || `${name}, ${day.label} ${e.time}`}
                        class="block h-auto w-full rounded-[10px]"
                        style={`aspect-ratio:${video.width}/${video.height}`}
                      />
                    </div>
                  )}

                  {/* A single photo gets its caption written into its own print mat,
                      like a note on a Polaroid's white border, rather than as a
                      separate paragraph under the whole card. */}
                  {singlePrint && prints[0].kind === "photo" && (
                    <div
                      class="diary-print mt-[15px] mx-auto bg-cream card-keyline rounded-[16px] p-[7px]"
                      style={`width:min(100%,${printWidth(prints[0].img.width, prints[0].img.height)}px);transform:rotate(${printTilt(i)})`}
                    >
                      <button
                        type="button"
                        aria-label="Enlarge photo"
                        class="diary-print-tap block mx-auto w-full cursor-zoom-in"
                      >
                        <Image
                          src={prints[0].img}
                          alt={prints[0].alt || `${name}, ${day.label} ${e.time}`}
                          width={Math.min(prints[0].img.width, 1160)}
                          loading="lazy"
                          decoding="async"
                          class="block h-auto w-full rounded-[10px]"
                        />
                      </button>
                      {matCaption && (
                        <p class="mt-[9px] px-1 text-center text-[13.5px] leading-snug text-pretty text-ink/70">{e.text}</p>
                      )}
                    </div>
                  )}

                  {manyPrints && (
                    <div class:list={{ "diary-prints": true, "diary-prints--pair": prints.length === 2, "diary-prints--quad": prints.length === 4, "mt-[15px]": true }}>
                      {prints.map((p, printIndex) => p.kind === "photo" && (
                        <button
                          type="button"
                          aria-label={`Enlarge photo ${printIndex + 1}`}
                          class="diary-print diary-print-tap block mx-auto bg-cream card-keyline rounded-[16px] p-[7px] cursor-zoom-in"
                          style={`width:min(100%,${printWidth(p.img.width, p.img.height)}px);transform:rotate(${printTilt(i + printIndex)})`}
                        >
                          <Image
                            src={p.img}
                            alt={p.alt || `${name}, ${day.label} ${e.time}`}
                            width={Math.min(p.img.width, 1160)}
                            loading="lazy"
                            decoding="async"
                            class="block h-auto w-full rounded-[10px]"
                          />
                        </button>
                      ))}
                    </div>
                  )}

                  {/* A caption with no mat to sit on gets its own slip of ruled
                      paper, torn off the pad, tucked under the prints. */}
                  {noteCaption && (
                    <div
                      class={`diary-slip diary-slip--tear-${i % 3} mt-4 mx-auto`}
                      style={`${noteWidth ? `width:min(100%,${noteWidth}px);` : ""}transform:rotate(${noteTilt(i)})`}
                    >
                      <div class="diary-slip-paper" aria-hidden="true"></div>
                      <div class="diary-note">
                        <p class="text-[14px] text-ink text-pretty">{e.text}</p>
                      </div>
                    </div>
                  )}

                  {e.text && !matCaption && !noteCaption && (
                    <p class={`${prints.length > 0 ? "mt-4" : "mt-2"} text-base leading-relaxed text-pretty max-w-[58ch]`}>{e.text}</p>
                  )}
                  <entry-reactions data-guest={entry.id} data-entry={e.id} />
                  </article>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    {days.length > 1 && (
      <script is:inline>
        (function () {
          var strip = document.querySelector(".day-strip");
          var chips = document.querySelectorAll(".day-chip");
          var sections = document.querySelectorAll(".diary-day");
          if (!strip || !chips.length || !sections.length) return;

          var chipByDay = {};
          chips.forEach(function (c) { chipByDay[c.dataset.day] = c; });

          var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          var current = null;

          function setActive(iso) {
            chips.forEach(function (c) { c.classList.toggle("active", c.dataset.day === iso); });
            var chip = chipByDay[iso];
            if (!chip) return;
            var target = chip.offsetLeft - (strip.clientWidth - chip.offsetWidth) / 2;
            strip.scrollTo({ left: Math.max(0, target), behavior: reduceMotion ? "auto" : "smooth" });
          }

          var observer = new IntersectionObserver(
            function (entries) {
              var visible = entries.filter(function (e) { return e.isIntersecting; });
              if (visible.length === 0) return;
              visible.sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
              var iso = visible[0].target.id.replace("day-", "");
              if (iso !== current) {
                current = iso;
                setActive(iso);
              }
            },
            { rootMargin: "-35% 0px -55% 0px", threshold: 0 },
          );
          sections.forEach(function (s) { observer.observe(s); });
        })();
      </script>
    )}
    </>
  )}

  <dialog id="print-viewer" class="print-viewer" aria-label="Photo">
    <form method="dialog">
      <button class="print-viewer-close" aria-label="Close">×</button>
    </form>
    <img alt="" />
  </dialog>

  <script is:inline define:vars={{ guestId: entry.id }}>
    (function () {
      // Tap a print to see it big. The <img> already loaded at up to 1160px,
      // which is plenty for a phone screen, so the viewer just borrows it.
      var viewer = document.getElementById("print-viewer");
      var big = viewer.querySelector("img");
      document.querySelectorAll("button.diary-print-tap").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var img = btn.querySelector("img");
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          viewer.showModal();
        });
      });
      // A tap on the dim backdrop closes it too, not just the ×.
      viewer.addEventListener("click", function (e) {
        if (e.target === viewer || e.target === big) viewer.close();
      });

      // "New since you last looked": owners check in a few times a day, so
      // flag entries that weren't on the page last time. The first visit
      // flags nothing; everything is new, which is the same as nothing.
      var tags = document.querySelectorAll("[data-entry-key]");
      var keys = [].map.call(tags, function (t) { return t.getAttribute("data-entry-key"); });
      var store = "tgp-seen-" + guestId;
      try {
        var seen = JSON.parse(localStorage.getItem(store) || "null");
        if (seen) {
          tags.forEach(function (t) {
            if (seen.indexOf(t.getAttribute("data-entry-key")) === -1) t.hidden = false;
          });
        }
        localStorage.setItem(store, JSON.stringify(seen ? seen.concat(keys.filter(function (k) { return seen.indexOf(k) === -1; })) : keys));
      } catch (e) {}
    })();
  </script>

  {showLive && (
    <script is:inline define:vars={{ stays }}>
      // The page is built once, so the build-time "Here today" pill goes stale.
      // Re-decide in the browser, and honour ?date=YYYY-MM-DD the same way the
      // homepage does so an upcoming stay can be previewed before check-in.
      (function () {
        var m = /[?&]date=(\d{4}-\d{2}-\d{2})\b/.exec(location.search);
        var today =
          (m && m[1]) ||
          new Intl.DateTimeFormat("en-CA", {
            timeZone: "Asia/Singapore",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          }).format(new Date());
        var stay = stays.filter((s) => s.checkIn <= today && today <= s.checkOut)[0];
        var el = document.getElementById("here-today");
        if (el) el.hidden = !stay;

        // "Day 4 of 11" while they're here. Dates are plain YYYY-MM-DD, so
        // parsing both as UTC midnight keeps the subtraction whole days.
        var dayEl = document.getElementById("stay-day");
        if (dayEl && stay && stay.checkIn !== stay.checkOut) {
          var ms = 86400000;
          var n = (Date.parse(today) - Date.parse(stay.checkIn)) / ms + 1;
          var of = (Date.parse(stay.checkOut) - Date.parse(stay.checkIn)) / ms + 1;
          dayEl.textContent = n === of ? "Last day" : "Day " + n + " of " + of;
          dayEl.hidden = false;
        }
      })();
    </script>
  )}
  <footer class="entrance entrance-delay-3 mt-12 border-t-[1.5px] border-line pt-[18px] text-xs tracking-[0.1em] uppercase text-label">
    Towner &middot; No dog of our own, just everyone else's
  </footer>
</Layout>
