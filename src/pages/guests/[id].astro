---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Cutout from "../../components/Cutout.astro";
import {
  parseDiary,
  stayLabel,
  staysNewestFirst,
  stayOn,
  latestStay,
  warnOnOverlaps,
  dateStr,
  skin,
  tilt,
  printTilt,
  printWidth,
  todaySGT,
} from "../../lib/guests";

// Diary photos are referenced from inside the markdown body, which parseDiary
// reads as raw text — so they never pass through Astro's markdown image
// pipeline. Globbing the folder here gets them optimized anyway.
const diaryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../content/guests/**/*.{jpeg,jpg,png,webp,avif}",
  { eager: true },
);

function resolveDiaryPhoto(src: string, guestId: string, when: string): ImageMetadata {
  const file = src.split("/").pop()!;
  const key = Object.keys(diaryImages).find((k) => k.endsWith(`/${file}`));
  if (!key) {
    throw new Error(
      `[guests] ${guestId}, ${when}: no image "${file}" in src/content/guests/ (written as "${src}")`,
    );
  }
  return diaryImages[key].default;
}

export async function getStaticPaths() {
  const entries = await getCollection("guests");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { name, breed, tagline, badge, bgColor, showLive, photo } = entry.data;

const stays = staysNewestFirst(
  entry.data.stays.map((s) => ({ checkIn: dateStr(s.checkIn), checkOut: dateStr(s.checkOut) })),
);
warnOnOverlaps(entry.id, stays);

const today = todaySGT();
const here = stayOn({ stays }, today);
const isLive = showLive && here !== undefined;
// The chip shows the visit that's happening, or the last one that did.
const shownStay = here ?? latestStay({ stays });

const days = parseDiary(entry.body ?? "", stays, entry.id);

// The palette rotates through the whole diary rather than restarting each
// day, so a long stay doesn't come out striped.
let skinIndex = 0;
---

<Layout title={`${name} · The Towner Godpawrents`}>
  <Nav />

  <a href="/" class="mt-8 inline-block text-sm font-semibold text-label transition-colors duration-200 hover:text-ink">
    ← Back to today
  </a>

  <div
    class="mt-4 relative rounded-[32px] pt-[26px] px-6 pb-[18px] overflow-hidden text-cream"
    style={`background:${bgColor}`}
  >
    {showLive && (
      <div
        id="here-today"
        class="absolute top-[18px] right-[18px] bg-lime text-ink font-semibold text-xs tracking-[0.06em] uppercase px-[13px] py-2 rounded-full"
        hidden={!isLive}
      >
        Here today
      </div>
    )}

    <h1 class="font-serif text-[clamp(48px,13vw,88px)] leading-[0.88] tracking-[-0.02em] max-w-full">
      {name}
    </h1>

    {tagline && (
      <div class="font-serif italic text-[20px] mt-2" style="color:#E9F7AE">
        {tagline}
      </div>
    )}

    <div class="mt-[14px] flex gap-2 flex-wrap">
      <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-cream">{breed}</span>
      <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-cream">
        {stayLabel(shownStay)}
      </span>
      {badge && (
        <span class="text-[13px] font-semibold px-[13px] py-[7px] rounded-full text-ink bg-lime">{badge}</span>
      )}
    </div>

    <div class="-mx-2 mt-[18px]" style="height:280px">
      <Cutout photo={photo} name={name} />
    </div>
  </div>

  <div class="mt-11 border-t-[1.5px] border-ink pt-[18px]">
    <div class="font-serif text-[32px] leading-none">The full diary</div>
  </div>

  {days.length === 0 ? (
    <p class="mt-3.5 text-sm text-label">No diary entries yet — check back once the visit gets going.</p>
  ) : (
    days.map((day) => (
      <section class="mt-7 first:mt-5">
        <div class="flex items-baseline gap-3">
          <div class="font-serif text-[22px] leading-none flex-none">{day.label}</div>
          <div class="h-px flex-1 bg-ink/20"></div>
        </div>

        <div class="mt-3.5 grid gap-3.5">
          {day.entries.map((e) => {
            const i = skinIndex++;
            const sk = skin(i);
            const img = e.photo
              ? resolveDiaryPhoto(e.photo.src, entry.id, `${day.label} ${e.time}`)
              : undefined;
            return (
              <div
                class="border-[1.5px] border-ink rounded-[24px] p-[17px_19px]"
                style={`background:${sk.bg};color:${sk.fg};transform:rotate(${tilt(i)})`}
              >
                <div class="font-semibold text-xs tracking-[0.08em] uppercase" style={`color:${sk.accent}`}>
                  {e.time}
                </div>

                {img && (
                  /* Cream mat + ink hairline on every skin: it disappears into the
                     cream cards and reads as a print border on the dark ones. */
                  <div
                    class="mt-[15px] mx-auto bg-cream border-[1.5px] border-ink rounded-[16px] p-[7px]"
                    style={`width:min(100%,${printWidth(img.width, img.height)}px);transform:rotate(${printTilt(i)})`}
                  >
                    <Image
                      src={img}
                      alt={e.photo!.alt || `${name}, ${day.label} ${e.time}`}
                      width={Math.min(img.width, 1160)}
                      loading="lazy"
                      decoding="async"
                      class="block h-auto w-full rounded-[10px]"
                    />
                  </div>
                )}

                {e.text && (
                  <p class={`${img ? "mt-4" : "mt-2"} text-base leading-relaxed text-pretty`}>{e.text}</p>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))
  )}

  {showLive && (
    <script is:inline define:vars={{ stays }}>
      // The page is built once, so the build-time "Here today" pill goes stale.
      // Re-decide in the browser, and honour ?date=YYYY-MM-DD the same way the
      // homepage does so an upcoming stay can be previewed before check-in.
      (function () {
        var m = /[?&]date=(\d{4}-\d{2}-\d{2})\b/.exec(location.search);
        var today =
          (m && m[1]) ||
          new Intl.DateTimeFormat("en-CA", {
            timeZone: "Asia/Singapore",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
          }).format(new Date());
        var el = document.getElementById("here-today");
        if (el) el.hidden = !stays.some((s) => s.checkIn <= today && today <= s.checkOut);
      })();
    </script>
  )}
</Layout>
