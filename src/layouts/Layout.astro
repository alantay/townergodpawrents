---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "The Towner Godpawrents" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta
      name="description"
      content="A dog or two, staying with us in Towner. See who's lepak-ing on the sofa today."
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Archivo:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans pb-24">
    <div class="mx-auto max-w-[660px] px-5">
      <slot />
    </div>
  </body>
</html>
