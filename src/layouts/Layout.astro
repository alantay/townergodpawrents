---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Site path of the link-preview image, e.g. "/og/tiny.jpg". */
  ogImage?: string;
}

const {
  title = "The Towner Godpawrents",
  description = "A dog or two, staying with us in Towner. See who's lepak-ing on the sofa today.",
  ogImage = "/images/alan-weiwen-portrait.jpg",
} = Astro.props;

const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Caveat:wght@500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans pb-24">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {/* Three cuts of the same torn edge rotate through the diary. Only the
        paper layer is displaced; the writing and its rules stay untouched. */}
    <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute">
      <filter id="torn-slip-0" x="-10%" y="-30%" width="120%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03 0.12" numOctaves="4" seed="5" result="tear" />
        <feDisplacementMap in="SourceGraphic" in2="tear" scale="13" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="torn-slip-1" x="-10%" y="-30%" width="120%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03 0.12" numOctaves="4" seed="11" result="tear" />
        <feDisplacementMap in="SourceGraphic" in2="tear" scale="13" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <filter id="torn-slip-2" x="-10%" y="-30%" width="120%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03 0.12" numOctaves="4" seed="17" result="tear" />
        <feDisplacementMap in="SourceGraphic" in2="tear" scale="13" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <main id="main-content" class="page-shell mx-auto max-w-[700px] px-5">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.documentElement.classList.add("js");

        function show(el) {
          el.classList.add("is-visible");
        }

        if (reduce || !("IntersectionObserver" in window)) {
          document.querySelectorAll(".reveal-card").forEach(show);
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              show(entry.target);
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12 },
        );

        function observeCards(root) {
          root.querySelectorAll(".reveal-card:not(.is-visible)").forEach(function (card) {
            observer.observe(card);
          });
        }

        observeCards(document);
        new MutationObserver(function (records) {
          records.forEach(function (record) {
            record.addedNodes.forEach(function (node) {
              if (!(node instanceof Element)) return;
              if (node.matches(".reveal-card")) observer.observe(node);
              observeCards(node);
            });
          });
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  </body>
</html>
