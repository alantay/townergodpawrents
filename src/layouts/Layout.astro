---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Site path of the link-preview image, e.g. "/og/tiny.jpg". Every
   * preview is drawn at 1200×630, see src/pages/og/. */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = "The Towner Godpawrents",
  description = "No dog of our own, just everyone else's. A diary of whoever's on our sofa.",
  ogImage = "/og/home.jpg",
  ogImageAlt = "The dogs who've stayed with us, lined up as photo prints",
} = Astro.props;

const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url);
const buildId: string = import.meta.env.BUILD_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="build-id" content={buildId} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Towner Godpawrents" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url)} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&family=Caveat:wght@500;600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-paper text-ink font-sans pb-24">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {/* Three cuts of the same torn edge rotate through the diary. Only the
        paper layer is displaced; the writing and its rules stay untouched.
        A tear has two scales: the slow wander of the rip, and the fibres
        that fray along it. Where the top layer of paper tears away from the
        bottom one it bares a pale fringe, wide in some places and gone in
        others, so the cream face is torn on its own slightly different line. */}
    <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute">
      {[5, 11, 17].map((seed, i) => (
        <filter id={`torn-slip-${i}`} x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
          <feTurbulence type="fractalNoise" baseFrequency="0.035 0.05" numOctaves="3" seed={seed} result="wander" />
          <feTurbulence type="fractalNoise" baseFrequency="0.035 0.05" numOctaves="3" seed={seed + 1} result="wander-face" />
          <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="1" seed={seed} result="fibre" />
          <feDisplacementMap in="SourceAlpha" in2="wander" scale="16" xChannelSelector="R" yChannelSelector="G" result="rip" />
          <feDisplacementMap in="rip" in2="fibre" scale="2" xChannelSelector="R" yChannelSelector="G" result="rip-frayed" />
          <feFlood flood-color="#fdfaf1" />
          <feComposite operator="in" in2="rip-frayed" result="fringe" />
          <feMorphology in="SourceAlpha" operator="erode" radius="3" result="face-core" />
          <feDisplacementMap in="face-core" in2="wander-face" scale="16" xChannelSelector="R" yChannelSelector="G" result="face-rip" />
          <feDisplacementMap in="face-rip" in2="fibre" scale="1.2" xChannelSelector="G" yChannelSelector="R" result="face-frayed" />
          <feFlood flood-color="#f7f2e7" />
          <feComposite operator="in" in2="face-frayed" />
          <feComposite operator="in" in2="rip-frayed" result="face" />
          <feMerge>
            <feMergeNode in="fringe" />
            <feMergeNode in="face" />
          </feMerge>
        </filter>
      ))}
      {/* A slow, small wobble for lines ruled by hand, like the calendar grid. */}
      <filter id="pencil-rule" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.015 0.02" numOctaves="2" seed="3" result="wobble" />
        <feDisplacementMap in="SourceGraphic" in2="wobble" scale="4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <main id="main-content" class="page-shell mx-auto max-w-[700px] px-5">
      <slot />
    </main>
    <script is:inline>
      (function () {
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        document.documentElement.classList.add("js");

        function show(el) {
          el.classList.add("is-visible");
        }

        if (reduce || !("IntersectionObserver" in window)) {
          document.querySelectorAll(".reveal-card").forEach(show);
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              show(entry.target);
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12 },
        );

        function observeCards(root) {
          root.querySelectorAll(".reveal-card:not(.is-visible)").forEach(function (card) {
            observer.observe(card);
          });
        }

        observeCards(document);
        new MutationObserver(function (records) {
          records.forEach(function (record) {
            record.addedNodes.forEach(function (node) {
              if (!(node instanceof Element)) return;
              if (node.matches(".reveal-card")) observer.observe(node);
              observeCards(node);
            });
          });
        }).observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    <script is:inline>
      // Phones keep tabs alive for days, and every page is built ahead of
      // time, so a tab left open shows whatever was on the sofa back then.
      // When the tab comes back into view, reload if a newer deploy is out,
      // or if it's a new day in Singapore (the "here today" picks go stale).
      (function () {
        var meta = document.querySelector('meta[name="build-id"]');
        if (!meta || !window.fetch || !window.DOMParser) return;
        var build = meta.content;
        var loadedDay = daySGT();
        var lastCheck = Date.now();
        var checking = false;

        function daySGT() {
          return new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Singapore" });
        }

        function check() {
          if (document.visibilityState !== "visible" || checking) return;
          if (daySGT() !== loadedDay) return location.reload();
          if (Date.now() - lastCheck < 5 * 60 * 1000) return;
          lastCheck = Date.now();
          checking = true;
          fetch(location.pathname, { cache: "no-store" })
            .then(function (res) {
              return res.ok ? res.text() : "";
            })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, "text/html");
              var latest = doc.querySelector('meta[name="build-id"]');
              if (latest && latest.content && latest.content !== build) location.reload();
            })
            .catch(function () {})
            .then(function () {
              checking = false;
            });
        }

        document.addEventListener("visibilitychange", check);
        window.addEventListener("pageshow", function (e) {
          if (e.persisted) check();
        });
      })();
    </script>
    <script>import "../scripts/reactions";</script>
  </body>
</html>
